---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ChatLauncher from '../components/ChatLauncher.astro';
import SeasonPill from '../components/SeasonPill.astro';
import { HALLOWEEN_LIVE } from '../data/season';
import LpFooter from '../components/LpFooter.astro';
import { SITE_URL, NAP, SOCIALS, FOUNDED } from '../data/site';
import { team } from '../data/team';
import { SERVICE_NAV, serviceHref } from '../data/service-nav';
import '../styles/base.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  /** field formation id for this route (routes.ts); "none" = poster lattice only */
  formation?: string;
  schema?: object | object[];
  noindex?: boolean;
  current?: string;
  bodyClass?: string;
  /** landing-page mode: logo + one CTA header, LP footer */
  lp?: 'usd' | 'php' | 'audit' | false;
  /** /services/<slug>: the service id (menu branch + dock chip) */
  service?: string;
}
const { title, description, image = '/og/home.png', formation = 'lattice', schema, noindex = false, current = '', bodyClass = '', lp = false, service = '' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = SITE_URL + (path === '/' ? '/' : path);
const ogImage = new URL(image, SITE_URL).toString();

const org = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#organization`,
      name: NAP.name,
      url: `${SITE_URL}/`,
      foundingDate: String(FOUNDED),
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/logo-512.png`, width: 512, height: 512 },
      image: `${SITE_URL}/og/home.png`,
      email: NAP.email,
      telephone: NAP.tel,
      address: { '@type': 'PostalAddress', addressLocality: NAP.city, addressRegion: NAP.region, postalCode: NAP.postal, addressCountry: NAP.countryCode },
      geo: { '@type': 'GeoCoordinates', latitude: '8.2280', longitude: '124.2452' },
      description: 'Fazed Digital is a web design, branding and SEO studio in Iligan City, Northern Mindanao, Philippines, building websites, brands and web apps for clients in the USA, Australia and the Philippines.',
      openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:30', closes: '17:00' }],
      priceRange: '$499–$20,000',
      areaServed: [{ '@type': 'Country', name: 'Philippines' }, { '@type': 'Country', name: 'United States' }, { '@type': 'Country', name: 'Australia' }],
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: NAP.email, telephone: NAP.tel, availableLanguage: ['English', 'Cebuano', 'Tagalog'] },
      knowsAbout: ['Web design', 'Brand identity', 'Search engine optimisation', 'Product design', 'Custom software development', 'WordPress', 'Astro', 'PrestaShop'],
      founder: [
        { '@type': 'Person', '@id': `${SITE_URL}/about#lord`, name: 'Lord Arcamo', jobTitle: 'Founder' },
        { '@type': 'Person', '@id': `${SITE_URL}/about#reancirl`, name: 'Reancirl Balaba', jobTitle: 'Co-Founder' },
      ],
      numberOfEmployees: { '@type': 'QuantitativeValue', value: team.length },
      hasOfferCatalog: {
        '@type': 'OfferCatalog', name: 'Digital Agency Services',
        // a service with its own page points at that page's Service entity (`${url}#service`)
        itemListElement: ([['web', 'Web Design & Development'], ['brand', 'Brand Identity'], ['seo', 'SEO Marketing'], ['product', 'Product Design'], ['systems', 'Custom Systems']] as const).map(([id, n]) => {
          const live = SERVICE_NAV.find((x) => x.id === id)?.live, url = `${SITE_URL}${serviceHref(id)}`;
          return { '@type': 'Offer', itemOffered: { '@type': 'Service', name: n, ...(live ? { '@id': `${url}#service`, url } : {}) } };
        }),
      },
      sameAs: SOCIALS.map((s) => s.href),
    },
    { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, url: `${SITE_URL}/`, name: 'Fazed Digital', inLanguage: 'en', publisher: { '@id': `${SITE_URL}/#organization` } },
  ],
};
// Site chat: nothing ships until ANTHROPIC_API_KEY is set (see src/pages/api/chat.ts). Off on the ad pages: they have one job.
const chatOn = !lp && !!(import.meta.env.ANTHROPIC_API_KEY ?? process.env.ANTHROPIC_API_KEY);
const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en" data-formation={formation}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <><meta name="robots" content="index, follow" /><link rel="canonical" href={canonical} /></>}
  <meta name="author" content="Fazed Digital" />
  <meta name="theme-color" content="#090909" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${title.split('|')[0].trim()}: Fazed Digital, web design and branding studio in Iligan City, Philippines`} />
  <meta property="og:site_name" content="Fazed Digital" />
  <meta property="og:locale" content="en_PH" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta property="og:locale:alternate" content="en_AU" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <slot name="head" />
  <link rel="preload" href="/fonts/clash/ClashDisplay-Semibold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // boot flags (≤1KB): js + reduced-motion + gl flags before first paint
    (function(d){var h=d.documentElement,q=location.search;h.classList.add('js');
    if(matchMedia('(prefers-reduced-motion: reduce)').matches)h.classList.add('rm');
    if(/[?&]record/.test(q))h.classList.add('record');
    if(scrollY>120)h.classList.add('is-docked');
    h.style.setProperty('--screen-h',innerHeight+'px');
    try{var m=q.match(/[?&]season=(\w+)/),S=sessionStorage;if(m)S.setItem('season',m[1]);var f=S.getItem('season'),t=new Date(Date.now()+288e5),md=(t.getUTCMonth()+1)*100+t.getUTCDate();
    if(f==='halloween'||(f!=='off'&&md>=1020&&md<=1101))h.classList.add('hw');if(S.getItem('hw-x'))h.classList.add('hw-off');}catch(e){}})(document); /* real visible height, see boot/main.ts */
  </script>
  <script is:inline>
    // Market swap: pesos and the PH line for visitors in the Philippines, dollars and the US line everywhere else.
    // The HTML stays complete for crawlers. Time zone decides before first paint; /api/geo (IP country) has the final say.
    // Blog article text (.prose) is left alone. Test with ?geo=ph or ?geo=intl.
    (function(w,d){var S;try{S=sessionStorage}catch(e){}
    var m=location.search.match(/[?&]geo=(ph|intl)/),g=m&&m[1],k='fz-geo',saved=S&&S.getItem(k);
    if(!g&&/bot|crawl|spider|slurp|lighthouse|pagespeed|headless/i.test(navigator.userAgent))return;
    if(g&&S)S.setItem(k,g);
    var tz='';try{tz=Intl.DateTimeFormat().resolvedOptions().timeZone}catch(e){}
    g=g||saved||(tz==='Asia/Manila'?'ph':'intl');
    var LP='/lp/7-day-website',PH=LP+'/ph',toUS={'19,999':'$499','34,999':'$899','59,999':'$1,499','14,999':'$499','2,500':'$79','3,500':'$99','60,000':'$1,500'},toPH={'1,499':'₱59,999','899':'₱34,999','499':'₱19,999','99':'₱3,500','79':'₱2,500'};
    function mark(){d.documentElement.dataset.geo=g;var p=location.pathname.replace(/\/$/,'');
    if(g==='intl'&&p===PH)location.replace(LP+location.search);if(g==='ph'&&p===LP)location.replace(PH+location.search)}
    function fix(s){return (g==='ph'?s.replace(/\$[\d,]+(\/month)? \((₱[\d,]+)(\/month)?[^)]*\)/g,function(x,a,b,c){return b+(a||c||'')}).replace(/\$[\d,]+(\/month)? (?:or|\/) (₱[\d,]+)(\/month)?/g,function(x,a,b,c){return b+(a||c||'')}).replace(/(₱[\d,]+(?:\/month)?) \(\$[^)]*\)/g,'$1').replace(/\$(1,499|899|499|99|79)(?!,?\d)/g,function(x,a){return toPH[a]})
    :s.replace(/₱[\d,]+(?:\/month)? \((\$[^)]*)\)/g,'$1').replace(/ \([^()]*₱[^()]*\)/g,'').replace(/ (?:or|\/) ₱[\d,]+(?:\/month)?/g,'').replace(/ Paying in pesos\?[^.]*\./g,'').replace(/₱(19,999|34,999|59,999|14,999|2,500|3,500|60,000)(?!,?\d)/g,function(x,a){return toUS[a]}).replace(/\+63 906 825 3451/g,'+1 302-405-2423')).replace(/([₱$][\d,]+)( · | or | \/ )\1(?!,?\d)/g,'$1')}
    function apply(){var b=d.body;if(!b)return;var t=d.createTreeWalker(b,4,{acceptNode:function(n){var p=n.parentNode;return !/[₱$]|\+63|pesos/.test(n.nodeValue)||!p||/^(SCRIPT|STYLE)$/.test(p.nodeName)||p.closest('.prose')?2:1}}),l=[],n;while(n=t.nextNode())l.push(n);
    l.forEach(function(x){var v=fix(x.nodeValue);if(v!==x.nodeValue)x.nodeValue=v});
    if(g==='intl'){d.querySelectorAll('a[href="tel:+639068253451"]').forEach(function(a){a.href='tel:+13024052423';var l=a.getAttribute('aria-label');if(l)a.setAttribute('aria-label',fix(l))});d.querySelectorAll('a.btn[href="'+PH+'"]').forEach(function(a){a.setAttribute('href',LP)});d.querySelectorAll('input[placeholder*="+63"]').forEach(function(i){i.placeholder='+1 555 000 0000'})}
    else d.querySelectorAll('a[href="'+LP+'"]:not(.ftr a)').forEach(function(a){a.setAttribute('href',PH)})}
    mark();w.__geoApply=apply;d.addEventListener('astro:after-swap',function(){mark();apply()});
    if(!saved&&!/[?&]geo=/.test(location.search))fetch('/api/geo').then(function(r){return r.json()}).then(function(j){if(!j.country)return;var c=j.country==='PH'?'ph':'intl';if(S)S.setItem(k,c);if(c!==g)location.reload()}).catch(function(){})
    })(window,document);
  </script>
  <ClientRouter fallback="swap" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {pageSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">Skip to content</a>
  <div id="field-root" transition:persist="field" aria-hidden="true">
    <div class="lattice"></div>
    <canvas id="field"></canvas>
  </div>
  <div id="cursor" transition:persist="cursor" aria-hidden="true"><div class="cur-ring"><span class="cur-label"></span></div><div class="cur-dot"></div></div>
  <Header current={current} lp={lp} service={service} />
  <main id="main" class="page" tabindex="-1">
    <slot />
  </main>
  {lp ? <LpFooter variant={lp} /> : <Footer />}
  {!lp && HALLOWEEN_LIVE && <SeasonPill />}
  <CookieBanner />
  {chatOn && <ChatLauncher />}
  <div id="route-announcer" class="sr-only" aria-live="polite"></div>
  <Analytics />
  <SpeedInsights />
  <script is:inline>window.__geoApply&&window.__geoApply()</script>
  <script>
    import '../boot/main';
  </script>
</body>
</html>
