---
// Free website check: landing page for Instagram leads who DM "7Days". One goal: book the 15-minute call.
// The booking widget is Fazed's Google Calendar appointment schedule (its own copy is the source of truth for
// what the call covers: phone-friendliness, a working contact form, pages Google can read).
// Landing-page chrome (lp="audit"): no site navigation, one CTA, no links off the page except new tabs.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { prices, results } from '../data/proof';
import { crumbs, faqPage, ORG_REF } from '../lib/schema';

const BOOK = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ2L1Fs1oTiHh8854mrEVtm_ny4BEhlyi5Pg-jdTsutFOInmrjHh4L-gxqLYqq_eM8pcUqxot6PF';
const checks = [
  ['phone', 'Is it easy on a phone?', 'Most people meet your business on a phone first. We check they can read it, tap it and find what they came for.'],
  ['form', 'Does your contact form actually work?', 'We check that an enquiry really reaches you. A broken form loses leads quietly, and you never hear about them.'],
  ['google', 'Can Google read your pages?', 'We look at the titles, descriptions and structure Google uses to decide when to show your business.'],
];
const steps = [
  ['Before', 'Pick a time', 'Choose a 15-minute slot. Times show in your own timezone.'],
  ['00:00', 'Join the call', 'The Google Meet link arrives by email. Have your website open.'],
  ['15:00', 'Leave with your 3 fixes', 'Make them yourself, or ask us to. No pressure either way.'],
];
const faq = [
  { q: 'Is it really free?', a: 'Yes. It’s a free 15-minute call with no obligation. If you’d like help afterwards, we’ll tell you what it would take and you decide.' },
  { q: 'I don’t have a website yet. Should I still book?', a: 'Yes. Book anyway, and we’ll talk about what you need and the simplest way to get your business online.' },
  { q: 'What should I prepare?', a: 'Just your website link (or your Facebook page if that’s all you have). Join from a laptop if you can, so we can look at it together.' },
  { q: 'Who will I talk to?', a: 'Someone from the Fazed Digital team, a small web studio in Iligan City, Philippines. We build websites for businesses in the Philippines, the USA and Australia.' },
  { q: 'What happens after the call?', a: `Nothing, unless you want it to. If you’d like us to make the fixes, ask about our 7-day website: a new site, live in 7 business days, from ${prices.php.starter} or ${prices.usd.starter}.` },
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': 'https://www.fazeddigital.com/audit#service',
    name: 'Free website check (15 minutes)', serviceType: 'Website review',
    description: 'A free 15-minute website check on Google Meet with the Fazed Digital team: is the site easy to use on a phone, does the contact form work, and can Google read the pages. You leave with the 3 fixes most likely to bring more calls and enquiries.',
    provider: ORG_REF, areaServed: 'Worldwide', availableChannel: { '@type': 'ServiceChannel', serviceUrl: 'https://www.fazeddigital.com/audit' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: 'https://www.fazeddigital.com/audit' },
  },
  faqPage(faq),
  crumbs([['Free website check', '/audit']]),
];
---
<Base title="Free Website Check: 15-Min Review on Google Meet | Fazed" description="Book a free 15-minute website check on Google Meet. We review your site with you and name the 3 fixes likely to bring more calls. No site yet? Book anyway." image="/og/audit.png" formation="lattice" schema={schema} lp="audit">
  <div class="au">
    <section class="au-hero" data-f="node" aria-labelledby="au-h">
      <div class="container au-hero-in">
        <p class="mono au-eyebrow"><span class="au-dot" aria-hidden="true"></span>Free website check · 15 min · Google Meet</p>
        <h1 id="au-h" class="t-d1">Three fixes that bring you <span class="dim">more calls.</span></h1>
        <p class="t-body-l au-deck">Book a free 15-minute call. We’ll look at your website with you and point out the 3 fixes that would bring you the most calls and enquiries. <strong>No site yet? Book anyway.</strong></p>
        <div class="lp-cta au-cta">
          <a class="btn btn--lime" href={BOOK} target="_blank" rel="noopener" data-book data-magnetic>Book my free check <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens the booking calendar)</span></a>
          <p class="mono au-note">Free · No obligation</p>
        </div>
        <!-- Illustration of the call: the three checks tick through. No results are shown or implied. -->
        <div class="au-card" aria-hidden="true">
          <p class="mono au-card-hd"><span class="au-card-dot"><span class="node-anchor" data-node-anchor></span></span>Website check · live call</p>
          <ol>{checks.map(([, t], i) => <li style={`--i:${i}`}><span class="mono au-k">0{i + 1}</span><span class="au-t">{t.replace('?', '')}</span><span class="au-tick"></span></li>)}</ol>
          <p class="mono au-card-ft"><span>= Your 3 fixes</span><span>15:00</span></p>
        </div>
      </div>
    </section>

    <section class="container au-sec au-checks" aria-labelledby="ck-h">
      <div class="au-sec-hd">
        <p class="mono">What we look at</p>
        <h2 id="ck-h" class="t-d2">Three questions. <span class="dim">Straight answers.</span></h2>
      </div>
      <ol class="au-rows">{checks.map(([k, t, b], i) => (
        <li class="au-row rv">
          <div class:list={['au-vis', `au-vis--${k}`]} aria-hidden="true">
            {k === 'phone' && <span class="vp"><i></i><i></i><i class="s"></i><b class="vp-btn"><em class="vp-tap"></em></b></span>}
            {k === 'form' && <><span class="vf"><i></i><i></i><b>Send</b></span><span class="vf-wire"><span class="vf-run"><em class="vf-dot"></em></span></span><span class="vf-in">1</span></>}
            {k === 'google' && <span class="vg"><span class="mono vg-u">yourbusiness.com</span><i class="vg-t"></i><i></i><i class="s"></i></span>}
          </div>
          <div class="au-row-tx"><span class="mono au-n">0{i + 1} / 03</span><h3 class="t-h3">{t}</h3><p>{b}</p></div>
        </li>
      ))}</ol>
    </section>

    <section class="container au-sec au-book" id="book" aria-labelledby="bk-h">
      <div class="au-book-hd">
        <p class="mono">Book your free check</p>
        <h2 id="bk-h" class="t-d2">Pick a time. <span class="dim">We’ll do the rest.</span></h2>
      </div>
      <!-- How it works: a 15-minute call drawn as a progress track. Dashed = before the call, lime = the call itself. -->
      <ol class="au-tl rv" aria-label="How it works">{steps.map(([ts, t, b], i) => (
        <li class:list={[i === 0 && 'is-pre', i === steps.length - 1 && 'is-end']}>
          <span class="mono au-ts">{ts}</span>
          <span class="au-tk" aria-hidden="true"><i class="au-tl-node"></i></span>
          <h3>{t}</h3><p>{b}</p>
        </li>
      ))}</ol>
      <!-- Google's scheduler never sits in the page flow (a 900px cross-origin frame with its own scroll fought the
           smooth scroll and lagged). It opens in a pop-up over the page, loaded on demand (full screen on phones). -->
      <div class="au-panel">
        <dl class="au-facts">
          <div><dt class="mono">Length</dt><dd>15 minutes</dd></div>
          <div><dt class="mono">Where</dt><dd>Google Meet</dd></div>
          <div><dt class="mono">Cost</dt><dd>Free, no obligation</dd></div>
        </dl>
        <a class="btn btn--lime au-panel-go" href={BOOK} target="_blank" rel="noopener" data-book>See available times <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens the booking calendar)</span></a>
      </div>
      <p class="au-alt">Prefer email? <a class="link" href="mailto:info@fazeddigital.com?subject=Free%20website%20check">info@fazeddigital.com</a></p>
    </section>

    <section class="container au-sec au-proof" aria-labelledby="pr-h">
      <div class="au-sec-hd">
        <p class="mono">Client results</p>
        <h2 id="pr-h" class="t-d2">Real clients. <span class="dim">Real results.</span></h2>
      </div>
      <ul class="au-res">{results.map((r) => <li class="rv"><div class="au-res-h"><p class="mono">{r.tag}</p><h3 class="t-h3">{r.statement}</h3></div><p>{r.body}</p></li>)}</ul>
    </section>

    <section class="container au-sec au-faq" aria-labelledby="fq-h">
      <h2 id="fq-h" class="t-d2">Common questions.</h2>
      <Faq items={faq} id="audit-faq" />
    </section>

    <section class="au-end on-lime" aria-label="Book your free check">
      <div class="container au-end-in">
        <p class="t-h3">Find your 3 fixes in 15 minutes.</p>
        <a class="btn btn--black" href={BOOK} target="_blank" rel="noopener" data-book>Book my free check <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens the booking calendar)</span></a>
      </div>
    </section>
  </div>
  <dialog class="au-dlg" data-cal aria-labelledby="dlg-h">
    <div class="au-dlg-hd">
      <p class="mono" id="dlg-h">Free website check<span class="au-dlg-x"> · 15 min · Google Meet</span></p>
      <button type="button" class="au-x" data-cal-close aria-label="Close the booking calendar">×</button>
    </div>
    <iframe data-src={`${BOOK}?gv=true`} title="Book a free 15-minute website check with Fazed Digital (Google Calendar)"></iframe>
  </dialog>
</Base>
<script>
  // Booking happens on this page: every Book button opens Google's scheduler in a pop-up (full screen on phones),
  // loaded on first open, with the page scroll paused. Without JS the link still goes to Google. Delegated once.
  const html = document.documentElement;
  const lenis = () => (window as any).__lenis;
  let opener: HTMLElement | null = null;
  function closeCal() {
    const d = document.querySelector<HTMLDialogElement>('[data-cal]');
    if (d?.open) d.close();
    if (!html.classList.contains('au-open')) return;
    html.classList.remove('au-open');
    lenis()?.start?.();
    const o = opener; setTimeout(() => o?.focus?.({ preventScroll: true }), 0);
  }
  if (!(window as any).__auBound) {
    (window as any).__auBound = true;
    document.addEventListener('click', (ev) => {
      const t = ev.target as Element;
      if (t.closest?.('[data-cal-close]') || t.matches?.('[data-cal]')) { closeCal(); return; } // × or a click on the backdrop
      const a = t.closest?.<HTMLAnchorElement>('[data-book]');
      if (!a) return;
      (window as any).gtag?.('event', 'audit_book_click', { from: a.closest('section')?.className.split(' ')[0] ?? '' });
      const d = document.querySelector<HTMLDialogElement>('[data-cal]');
      if (!d || ev.metaKey || ev.ctrlKey || ev.shiftKey) return; // no JS or a new-tab click: the link goes to Google
      ev.preventDefault();
      const f = d.querySelector('iframe')!;
      if (!f.src) f.src = f.dataset.src!;
      opener = a;
      d.showModal();
      html.classList.add('au-open');
      lenis()?.stop?.();
    });
    document.addEventListener('cancel', (ev) => { if ((ev.target as Element).matches?.('[data-cal]')) { ev.preventDefault(); closeCal(); } }, true);
    document.addEventListener('close', (ev) => { if ((ev.target as Element).matches?.('[data-cal]')) closeCal(); }, true);
    document.addEventListener('astro:before-swap', closeCal);
  }
</script>
<style>
  .au-hero { position: relative; min-height: 88svh; display: flex; align-items: center; padding: calc(var(--header-h) + 72px) 0 72px; }
  .au-hero-in { display: grid; gap: 1.5rem; }
  @media (min-width: 1024px) {
    .au-hero-in { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--gutter); align-items: center; }
    .au-hero-in > :not(.au-card) { grid-column: 1; }
    .au-card { grid-column: 2; grid-row: 1 / span 4; }
  }
  .au-card { border: 1px solid var(--gray-700); background: var(--gray-900); border-radius: 16px; padding: 22px 24px; display: grid; gap: 14px; box-shadow: var(--capsule-sh); }
  .au-card-hd, .au-card-ft { display: flex; align-items: center; gap: .6rem; color: var(--gray-300); margin: 0; }
  .au-card-ft { justify-content: space-between; color: var(--lime); border-top: 1px solid var(--gray-700); padding-top: 14px; }
  .au-card-dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--lime); }
  .au-card-dot .node-anchor { position: absolute; left: 50%; top: 50%; width: 1px; height: 1px; }
  .au-card ol { display: grid; gap: 10px; }
  .au-card li { display: grid; grid-template-columns: 2rem 1fr 22px; align-items: center; gap: .5rem; min-height: 52px; padding: 0 14px; border: 1px solid var(--gray-700); border-radius: 10px; background: var(--gray-800); }
  .au-k { color: var(--gray-400); }
  .au-t { font-weight: 500; }
  /* each row "checks" in turn: the ring fills lime, then the row settles; loops slowly */
  .au-tick { width: 18px; height: 18px; border-radius: 50%; border: 1px solid var(--gray-400); position: relative; animation: au-tick 7.5s calc(var(--i) * 1.4s + .6s) infinite both; }
  .au-tick::after { content: ''; position: absolute; left: 5px; top: 2px; width: 5px; height: 9px; border: solid var(--black); border-width: 0 2px 2px 0; rotate: 45deg; opacity: 0; animation: au-mark 7.5s calc(var(--i) * 1.4s + .6s) infinite both; }
  @keyframes au-tick { 0%, 8% { background: transparent; border-color: var(--gray-400); } 14%, 88% { background: var(--lime); border-color: var(--lime); } 100% { background: transparent; border-color: var(--gray-400); } }
  @keyframes au-mark { 0%, 10% { opacity: 0; } 16%, 88% { opacity: 1; } 100% { opacity: 0; } }
  .au-hero h1 { max-width: 13ch; }
  .au-eyebrow { display: inline-flex; align-items: center; gap: .6rem; color: var(--lime); }
  .au-dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--lime); }
  .au-dot::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--lime); animation: au-pulse 2.4s ease-out infinite; }
  @keyframes au-pulse { 0% { transform: scale(.5); opacity: .8; } 100% { transform: scale(1.4); opacity: 0; } }
  .au-deck { max-width: 54ch; }
  .au-deck strong { color: var(--white); }
  .au-cta { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; }
  .au-note { color: var(--gray-300); }

  /* tighter rhythm than the site's 192px .section: this page is one scroll to a booking */
  .au-sec { position: relative; display: grid; gap: 2rem; padding-block: clamp(48px, 5.5vw, 88px); }
  .au-sec-hd { display: grid; gap: .75rem; }
  .au-n { color: var(--lime); }

  /* What we look at: each check gets a small drawing of the thing we actually test */
  .au-rows { display: grid; border-top: 1px solid var(--gray-700); }
  .au-row { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(1.25rem, 3vw, 3rem); align-items: center; padding-block: 28px; border-bottom: 1px solid var(--gray-700); }
  .au-row-tx { display: grid; gap: .5rem; max-width: 56ch; }
  .au-row-tx p { color: var(--gray-300); }
  .au-vis { position: relative; height: 136px; border: 1px solid var(--gray-700); border-radius: 14px; background: radial-gradient(circle at 1px 1px, var(--gray-700) 1px, transparent 1.5px) 0 0 / 12px 12px, var(--gray-900); display: grid; place-items: center; overflow: hidden; }
  .au-vis i { display: block; height: 5px; border-radius: 3px; background: var(--gray-500); }
  .au-vis i.s { width: 60%; }
  /* phone: a screen with text and a lime button being tapped */
  .vp { position: relative; width: 62px; height: 104px; border: 1.5px solid var(--gray-400); border-radius: 12px; padding: 16px 9px 0; display: grid; align-content: start; gap: 6px; }
  .vp::before { content: ''; position: absolute; top: 6px; left: 50%; width: 14px; height: 3px; translate: -50% 0; border-radius: 2px; background: var(--gray-500); }
  .vp-btn { position: absolute; left: 9px; right: 9px; bottom: 12px; height: 14px; border-radius: 7px; background: var(--lime); }
  .vp-tap { position: absolute; left: 50%; top: 50%; width: 30px; height: 30px; margin: -15px; border-radius: 50%; border: 1.5px solid var(--lime); animation: au-tap 2.4s ease-out infinite; }
  @keyframes au-tap { 0% { scale: .3; opacity: 1; } 70%, 100% { scale: 1.6; opacity: 0; } }
  /* form: an enquiry leaves the form and lands in the inbox */
  .au-vis--form { grid-template-columns: auto 1fr auto; padding: 0 18px; gap: 8px; place-items: center stretch; }
  .vf { width: 64px; display: grid; gap: 6px; padding: 10px 8px; border: 1px solid var(--gray-500); border-radius: 8px; background: var(--gray-800); }
  .vf b { font: 700 9px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--black); background: var(--lime); border-radius: 4px; padding: 4px 0; text-align: center; }
  .vf-wire { position: relative; height: 1px; background: repeating-linear-gradient(90deg, var(--gray-500) 0 4px, transparent 4px 8px); }
  .vf-run { position: absolute; inset: 0 8px 0 0; animation: au-send 2.6s cubic-bezier(.6, 0, .3, 1) infinite; }
  .vf-dot { position: absolute; top: -3.5px; left: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 10px var(--lime); animation: au-fade 2.6s linear infinite; }
  @keyframes au-send { 0% { transform: translateX(0); } 75%, 100% { transform: translateX(100%); } }
  @keyframes au-fade { 0% { opacity: 0; } 10%, 75% { opacity: 1; } 85%, 100% { opacity: 0; } }
  .vf-in { width: 34px; height: 34px; border-radius: 50%; border: 1.5px solid var(--lime); display: grid; place-items: center; font: 700 12px/1 var(--font-mono); color: var(--lime); justify-self: center; }
  /* google: the result Google shows when it can read the page */
  .vg { width: 168px; display: grid; gap: 7px; padding: 14px; border: 1px solid var(--gray-700); border-radius: 10px; background: var(--gray-800); }
  .vg-u { font-size: 9px; letter-spacing: .06em; color: var(--gray-400); }
  .au-vis .vg-t { height: 8px; width: 82%; background: var(--lime); }

  /* How it works (inside #book): each step owns the track segment to the next node, so the line always meets
     the node centres and stops at the last one. Segment 1 = before the call (dashed), segment 2 = the call (lime). */
  .au-tl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin-bottom: .5rem; }
  .au-tl li { display: grid; gap: .4rem; align-content: start; }
  .au-ts { color: var(--gray-300); font-size: 12px; letter-spacing: .12em; }
  .au-tk { position: relative; display: flex; align-items: center; height: 14px; margin: 6px 0 10px; }
  .au-tl-node { position: relative; z-index: 1; flex: none; width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--lime); background: var(--black); }
  .au-tl li:not(.is-end) .au-tk::after { content: ''; position: absolute; left: 13px; right: calc(-1 * var(--gutter)); top: 50%; height: 1px; translate: 0 -50%; }
  .au-tl li.is-pre .au-tk::after { background: repeating-linear-gradient(90deg, var(--gray-500) 0 5px, transparent 5px 10px); }
  /* the call segment fills like a progress bar when the steps scroll in (--fill 0 → 1) */
  .au-tl li:not(.is-pre):not(.is-end) .au-tk::after { height: 3px; border-radius: 2px; background: var(--lime); transform-origin: left; scale: var(--fill, 0) 1; transition: scale 1.4s var(--ease-out) .25s; }
  .au-tl.rv-in, :global(html:not(.js-motion)) .au-tl { --fill: 1; }
  .au-tl li.is-end .au-tl-node { background: var(--lime); box-shadow: 0 0 0 6px rgba(201, 255, 87, .15); }
  .au-tl h3 { font: 600 1.125rem/1.3 var(--font-display, inherit); }
  .au-tl p { color: var(--gray-300); max-width: 34ch; }

  /* Client results as editorial rows */
  .au-res { border-top: 1px solid var(--gray-700); }
  .au-res li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gutter); align-items: end; padding-block: 24px; border-bottom: 1px solid var(--gray-700); }
  .au-res-h { display: grid; gap: .5rem; }
  .au-res .mono { color: var(--lime); }
  .au-res li > p { color: var(--gray-300); }

  .au-book-hd { display: grid; gap: .75rem; }
  .au-panel { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding: 24px 28px; border: 1px solid var(--gray-700); border-radius: 16px; background: var(--gray-900); }
  .au-facts { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; }
  .au-facts dt { color: var(--gray-400); font-size: 12px; letter-spacing: .12em; }
  .au-facts dd { margin: .25rem 0 0; font-weight: 600; }
  .au-panel-go { min-height: 56px; }

  /* the pop-up: Google's light scheduler under a dark header bar */
  :global(html.au-open) { overflow: hidden; scrollbar-gutter: stable; }
  .au-dlg { margin: auto; padding: 0; border: 1px solid var(--gray-700); border-radius: 16px; background: #fff; width: min(1080px, calc(100vw - 48px)); height: min(900px, calc(100svh - 48px)); max-width: none; max-height: none; overflow: hidden; box-shadow: var(--capsule-sh); }
  .au-dlg[open] { display: flex; flex-direction: column; }
  .au-dlg::backdrop { background: rgba(9, 9, 9, .72); backdrop-filter: blur(4px); }
  .au-dlg-hd { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 56px; padding: 0 8px 0 20px; background: var(--gray-900); color: var(--gray-300); }
  .au-dlg-hd .mono { margin: 0; font-size: 12px; letter-spacing: .12em; }
  .au-x { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--gray-500); background: transparent; color: var(--white); font-size: 1.4rem; line-height: 1; cursor: pointer; }
  .au-x:hover { border-color: var(--lime); color: var(--lime); }
  .au-x:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }
  .au-dlg iframe { flex: 1; width: 100%; border: 0; background: #fff; }
  @media (max-width: 767px) {
    /* phones: a full-screen sheet that slides up; the calendar scrolls inside it */
    .au-dlg { width: 100vw; height: 100dvh; border: 0; border-radius: 0; padding-top: env(safe-area-inset-top); background: var(--gray-900); }
    .au-dlg[open] { animation: au-up .36s var(--ease-out); }
    .au-dlg-x { display: none; }
    .au-dlg iframe { -webkit-overflow-scrolling: touch; }
  }
  @keyframes au-up { from { transform: translateY(100%); } }
  .au-alt { color: var(--gray-300); display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .5rem; }

  .au-end { padding: 64px 0; }
  .au-end-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; }
  .au-end .t-h3 { color: var(--black); }

  @media (min-width: 1024px) {
    /* headings sit in a left column beside the rows */
