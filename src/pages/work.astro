---
import Base from '../layouts/Base.astro';
import WorkIndex from '../components/WorkIndex.astro';
import { caseIndex, countries } from '../data/cases';
import { SITE_URL } from '../data/site';
import { crumbs } from '../lib/schema';
const count = (d: string) => caseIndex.filter((c) => (c.discipline as string[]).includes(d)).length;
const filters = [['all', 'All', caseIndex.length], ['brand', 'Brand', count('brand')], ['web', 'Web', count('web')], ['systems', 'Systems', count('systems')]] as const;
const schema = [
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Fazed Digital case studies', itemListElement: caseIndex.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE_URL}/work/${c.slug}`, name: c.title })) },
  crumbs([['Work', '/work']]),
];
---
<Base
  title="Web Design Portfolio & Case Studies | Fazed Digital"
  description="8 live projects for clients in the USA, Australia and the Philippines: websites, brands, web apps and portals. See what we built and what changed."
  formation="lattice"
  schema={schema}
  current="/work"
>
  <section class="w-hero" data-f="lattice" aria-labelledby="w-h">
    <div class="container w-hero-in">
      <p class="mono">Selected work · 08 cases · {String(countries.length).padStart(2, '0')} countries · 2024–2025</p>
      <h1 id="w-h" class="t-d2"><span class="h-l1">Live sites.</span> <span class="h-l2">Real businesses.</span></h1>
      <p class="t-body-l w-deck">Eight of the 120+ projects Fazed Digital has delivered since 2022, for clients in the USA, Australia and the Philippines. Websites, brands, platforms and portals for a framing contractor in Utah, a law firm in Queensland, a cleaning brand at home and five more. Each build took 5 to 14 weeks. Every one is live.</p>
      <p class="mono w-lab">Concept work lives in the <a class="link" href="/lab">Lab →</a></p>
    </div>
  </section>
  <section class="section w-list" data-f="work" aria-labelledby="w-list-h">
    <div class="container">
      <h2 id="w-list-h" class="sr-only">All case studies</h2>
      <div class="w-filters" role="group" aria-label="Filter case studies by type">
        {filters.map(([id, label, n]) => <a class="chip w-chip" href={id === 'all' ? '/work' : `/work?f=${id}`} data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'} role="button">{label} <span>{String(n).padStart(2, '0')}</span></a>)}
      </div>
      <p class="w-empty" role="status" hidden>No cases on this node yet. Try All.</p>
      <WorkIndex services />
    </div>
  </section>
  <section class="section w-cta" data-f="node" aria-labelledby="w-cta-h">
    <div class="container w-cta-in">
      <span class="node-anchor" data-node-anchor aria-hidden="true"></span>
      <h2 id="w-cta-h" class="t-d1">Want to be <span class="dim">row 09?</span></h2>
      <p class="t-body-l">Tell us what you’re building. We’ll reply within one business day.</p>
      <div class="w-btns"><a class="btn btn--lime" href="/contact" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a><a class="btn btn--ghost" href="/lp/7-day-website">Get live in 7 days</a></div>
    </div>
  </section>
</Base>
<script>
  // filters: GSAP-free so it stays in the pre-3D budget; non-matching rows dim (field nodes go gray via fz:filter)
  function initFilters() {
    const root = document.querySelector<HTMLElement>('.w-filters');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const rows = [...document.querySelectorAll<HTMLElement>('.wli')];
    const empty = document.querySelector<HTMLElement>('.w-empty');
    const apply = (f: string, push = true) => {
      root.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      let shown = 0;
      rows.forEach((r) => { const on = f === 'all' || (r.dataset.disc || '').split(' ').includes(f); r.classList.toggle('is-dim', !on); r.querySelector('a')?.setAttribute('tabindex', on ? '0' : '-1'); if (on) shown++; });
      if (empty) empty.hidden = shown > 0;
      if (push) history.replaceState(history.state, '', f === 'all' ? '/work' : `/work?f=${f}`);
      document.dispatchEvent(new CustomEvent('fz:filter', { detail: f }));
    };
    root.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]'); if (!b) return; e.preventDefault(); apply(b.dataset.filter!); });
    root.addEventListener('keydown', (e) => { if (e.key === ' ') { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]'); if (b) { e.preventDefault(); apply(b.dataset.filter!); } } });
    const q = new URLSearchParams(location.search).get('f');
    if (q && ['brand', 'web', 'systems'].includes(q)) apply(q, false);
  }
  document.addEventListener('astro:page-load', initFilters);
  initFilters();
</script>
<style>
  /* the index is the hero: a compact D2 head, the table starts in the first viewport */
  .w-hero { position: relative; padding: calc(var(--header-h) + 64px) 0 24px; }
  .w-hero-in { display: grid; grid-template-columns: auto minmax(0, 52ch); align-items: end; gap: 1rem var(--gutter); }
  .w-hero-in > .mono { grid-column: 1 / -1; }
  .w-hero h1 { max-width: none; }
  /* two-line rhythm like home: line 2 in gray-400 */
  .w-hero h1 .h-l1, .w-hero h1 .h-l2 { display: block; } .w-hero h1 .h-l2 { color: var(--gray-400); }
  @media (min-width: 768px) { .w-hero h1 .h-l1, .w-hero h1 .h-l2 { white-space: nowrap; } }
  @media (max-width: 1023px) { .w-hero-in { grid-template-columns: 1fr; } .w-hero h1 { font-size: clamp(2.75rem, 7vw, 3.6rem); } }
  @media (max-width: 479px) { .w-hero h1 { font-size: min(2.75rem, 11.4vw); } } /* "Real businesses." stays one line at 375/390 */
  .w-deck { max-width: 56ch; }
  .w-lab { grid-column: 2; margin-top: -.25rem; } .w-lab .link { display: inline-block; padding-block: 13px; margin-block: -13px; background-clip: content-box; text-transform: none; letter-spacing: .04em; }
  @media (max-width: 1023px) { .w-lab { grid-column: 1; } }
  .w-list { padding-top: 16px; }
  .w-filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .w-chip { min-height: 44px; gap: .5rem; color: var(--gray-300); cursor: pointer; }
  .w-chip span { color: var(--gray-400); }
  .w-chip[aria-pressed='true'] { background: var(--lime); color: var(--black); border-color: var(--lime); }
  .w-chip[aria-pressed='true'] span { color: var(--black); }
  .w-empty { margin-bottom: 1rem; }
  .w-cta-in { display: grid; gap: 1.5rem; justify-items: start; position: relative; padding-top: 140px; }
  .w-btns { display: flex; gap: .75rem; flex-wrap: wrap; }
  .node-anchor { position: absolute; left: 24px; top: 24px; }
  @media (max-width: 767px) { .w-poster { width: 70vw; top: 28%; opacity: .7; } }
</style>
