---
import Layout from '../layouts/Layout.astro';
import Loader from '../components/Loader';
import Cursor from '../components/Cursor';
import Nav from '../components/Nav';
import HeroSection from '../components/HeroSection';
import MarqueeSection from '../components/MarqueeSection';
import ServicesSection from '../components/ServicesSection';
import WorkSection from '../components/WorkSection';
import ProcessSection from '../components/ProcessSection';
import StatsSection from '../components/StatsSection';
import AboutSection from '../components/AboutSection';
import ImageStrip from '../components/ImageStrip';
import WhyFazedSection from '../components/WhyFazedSection';
import TestimonialsSection from '../components/TestimonialsSection';
import ContactSection from '../components/ContactSection';
import Footer from '../components/Footer';
---

<Layout
  title="Web Design & Branding Agency in Iligan City | Fazed Digital"
  description="Fazed Digital is a web design, branding & SEO agency in Iligan City, Philippines. We build fast, conversion-focused websites that turn visitors into customers — get a free quote today."
  image="/og/home.png"
  page="home"
>
  <Cursor client:idle />
  <Loader client:only="react" />
  <Nav client:only="react" currentPath="/" />

  <main>
    <HeroSection client:only="react" />
    <MarqueeSection client:only="react" />
    <ServicesSection client:visible />
    <WorkSection client:visible />
    <ProcessSection client:visible />
    <ImageStrip client:visible />
    <StatsSection client:visible />
    <WhyFazedSection client:visible />
    <AboutSection client:visible />
    <TestimonialsSection client:visible />
    <ContactSection client:visible />
  </main>

  <Footer client:visible />
</Layout>
