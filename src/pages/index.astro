---
import Base from '../layouts/Base.astro';
import MarkPoster from '../components/MarkPoster.astro';
import ContactForm from '../components/ContactForm.astro';
import WorkIndex from '../components/WorkIndex.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import LabSheetPoster from '../components/LabSheetPoster.astro';
import { labShipped, LAB_TOTAL, LABEL, pad2 } from '../data/lab';
import { services } from '../data/services';
import { serviceHref, SERVICE_TOTAL } from '../data/service-nav';
import { homeFaq } from '../data/home';
import Faq from '../components/Faq.astro';
import { faqPage } from '../lib/schema';
import { caseIndex, countries, FEATURED } from '../data/cases';
import { stats, results, capsCopy } from '../data/proof';
import { team } from '../data/team';
import { NAP, SITE_URL } from '../data/site';
import { MARK_PATHS, MARK_TRANSFORM, MARK_VIEWBOX } from '../../scripts/lib/mark.mjs';

// The top sheets of the services deck are miniatures of this page, so the copy they repeat is written once, here.
const pageTitle = 'Web Design & Branding Studio in the Philippines | Fazed';
const pageDesc = 'Custom websites, brands, SEO and web apps from Iligan City, Philippines, for businesses in the USA, Australia and the Philippines. 7-day sites from $499.';
const heroLines = ['Built in Iligan.', 'Live worldwide.'];
// the hub's count ("Seven services. One connected brand.", approved 2026-11-10), from service-nav.ts so it can't drift
const SERVICE_WORD = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'][SERVICE_TOTAL] ?? String(SERVICE_TOTAL);
const heroDeck = 'Websites, brands and web apps for owners who want to be found, trusted and chosen. Made in the Philippines, shipped to the USA, Australia and home.';
const unfoldLines = ['Web design, branding', 'and SEO from the Philippines.'];
const searchLine = unfoldLines.join(' ').replace(/\.$/, '');
const navLabels = ['Work', 'Lab', 'Services', 'About', 'Blog', 'Contact'];
const caseListName = 'Fazed Digital case studies';
const schemaLine = `[{ "@type": "ItemList", "name": "${caseListName}" }, { "@type": "FAQPage" }]`;
const cols = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
const days = ['Day 1 · Brief', 'Day 2 · Design', 'Day 3 · Design', 'Day 4 · Build', 'Day 5 · Build', 'Day 6 · Review', 'Day 7 · Launch'];
const steps = [
  ['01', 'Discover', 'We learn your business, your market and your customers. No guessing, just the right questions.'],
  ['02', 'Strategy', 'The answers become a plan: structure, message and a brief every later decision points back to.'],
  ['03', 'Design', 'Every visual and every word, from logo to layout, with the detail most people only feel.'],
  ['04', 'Launch', 'We ship, measure and fix. You get the keys: domain, hosting, logins and files, all in your name.'],
];
// Lab feature: the newest three concept sites, newest first (#04 Halde stays off sales pages: CC BY-NC base model)
const labNew = labShipped.filter((i) => i.n !== '04' && i.url).reverse().slice(0, 3);
// arcs: Iligan → each distinct client location (from cases.ts only)
const arcDests = [...new Map(caseIndex.filter((c) => Math.hypot(c.lat - 8.23, c.lon - 124.24) > 1).map((c) => [`${c.lat},${c.lon}`, [c.lat, c.lon]])).values()];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: caseListName,
    itemListElement: caseIndex.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: `${SITE_URL}/work/${c.slug}` })),
  },
  faqPage(homeFaq),
];
---
<Base
  title={pageTitle}
  description={pageDesc}
  formation="mark"
  schema={schema}
  current="/"
>
  <div data-page="home">
    <!-- [HOME-01] MARK -->
    <section class="hero" id="top" data-f="mark" aria-labelledby="hero-h">
      <MarkPoster />
      <div class="container hero-in">
        <p class="mono hero-strip"><span class="hs-d">Iligan City, PH · {NAP.coords} · Est. 2022</span><span class="hs-m" aria-hidden="true">Iligan, PH · {NAP.coords.split(" N")[0]} N · Est. 2022</span></p>
        <h1 id="hero-h" class="hero-h"><span class="hero-l1">{heroLines[0]}</span> <span class="hero-l2">{heroLines[1]}</span></h1>
        <p class="t-body-l hero-deck">{heroDeck}</p>
        <div class="hero-cta">
          <a class="btn btn--lime" href="/contact" data-magnetic data-cursor="GO →">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/work">See the work</a>
        </div>
        <p class="mono hero-cue" aria-hidden="true">Scroll · 01 / 09</p>
      </div>
    </section>

    <!-- [HOME-02] UNFOLD -->
    <section class="section unfold" id="unfold" data-f="lattice" aria-labelledby="unfold-h">
      <div class="ruler container" aria-hidden="true">{cols.map((c) => <span class="mono" data-c={c}></span>)}<span class="mono ruler-pitch"></span></div>
      <div class="container unfold-in">
        <h2 id="unfold-h" class="t-d1 rv">{unfoldLines[0]} <span class="dim">{unfoldLines[1]}</span></h2>
        <div class="unfold-body">
          <p class="t-body-l rv">Fazed Digital is a small studio in <a class="link" href="/web-design-iligan-city">Iligan City</a>, Mindanao. We design and build the websites, brand systems and custom tools that small and mid-sized businesses run on, from a framing contractor in Utah to a law firm in Queensland.</p>
          <p class="rv">Every project starts with the same three questions: who are you, who are you talking to, and what do you want them to feel? The answers shape everything that follows.</p>
        </div>
        <dl class="unfold-facts rv">
          <div><dt class="mono">Based in</dt><dd>Iligan City, Philippines</dd></div>
          <div><dt class="mono">Shipping to</dt><dd>{countries.join(', ')}</dd></div>
          <div><dt class="mono">Since</dt><dd>2022</dd></div>
          <div><dt class="mono">Live work</dt><dd><a class="link" href="/work">{caseIndex.length} case studies</a></dd></div>
        </dl>
      </div>
    </section>

    <!-- [HOME-03] SERVICES: a flat miniature of this page tips back into five sheets, one per service (motion/services.ts). -->
    <section class="services" id="services" data-f="lattice" data-fquiet="0.35" aria-labelledby="svc-h">
      <div class="container svc-head">
        <h2 id="svc-h" class="svc-h rv">This page is five layers deep.</h2>
        <p class="svc-intro rv">Web design on top. Branding, SEO, product design and custom systems underneath. {SERVICE_WORD} services, one connected system. <a class="link" href="/services">See all {SERVICE_WORD.toLowerCase()}</a></p>
      </div>
      <div class="rig">
        <div class="stage">
          <div class="scene" aria-hidden="true">
            <a class="plane p-web" style="--i:0" href={serviceHref(services[0].id)} tabindex="-1" data-i="0"><div class="pl-in">
              <svg class="p-mark" viewBox={MARK_VIEWBOX.join(' ')}><defs><g id="sv-mark" transform={MARK_TRANSFORM}>{MARK_PATHS.map((d) => <path d={d} />)}</g><pattern id="sv-dots" width="30" height="30" patternUnits="userSpaceOnUse"><circle cx="15" cy="15" r="9.5" fill="currentColor" /></pattern><mask id="sv-mask"><use class="t-mask" href="#sv-mark" /></mask></defs><rect x={MARK_VIEWBOX[0]} y={MARK_VIEWBOX[1]} width={MARK_VIEWBOX[2]} height={MARK_VIEWBOX[3]} fill="url(#sv-dots)" mask="url(#sv-mask)" /></svg>
              <span class="bar">{navLabels.map((l) => <span>{l}</span>)}<b>7 Days →</b></span>
              <div class="big">{heroLines[0]}<span>{heroLines[1]}</span></div>
              <p>{heroDeck}</p>
              <span class="go">Start a project →</span>
            </div><i class="shade"></i></a>
            <a class="plane p-brand" style="--i:1" href={serviceHref(services[1].id)} tabindex="-1" data-i="1"><div class="pl-in">
              <svg class="p-mark" viewBox={MARK_VIEWBOX.join(' ')}><use class="t-solid" href="#sv-mark" /></svg>
              <div class="aa">Aa</div>
              <div class="sw"><i></i><i></i><i></i></div>
              <div class="fonts">#090909 #F5F4F0 #C9FF57<br />Clash Display / Plus Jakarta Sans / Space Mono</div>
            </div><i class="shade"></i></a>
            <a class="plane p-seo" style="--i:2" href={serviceHref(services[2].id)} tabindex="-1" data-i="2"><div class="pl-in">
              <div class="q"><i></i>{searchLine}</div>
              <div><div class="url">www.fazeddigital.com</div><div class="ttl">{pageTitle}</div><div class="dsc">{pageDesc}</div></div>
              <pre>{schemaLine}</pre>
            </div><i class="shade"></i></a>
            <a class="plane p-prod" style="--i:3" href={serviceHref(services[3].id)} tabindex="-1" data-i="3"><div class="pl-in">
              <svg class="ux" viewBox="0 0 1000 625">
                <rect class="ux-bar" width="1000" height="46" />
                <text class="ux-m ux-hi" x="36" y="29">7-Day Brief</text><text class="ux-m" x="176" y="29">/ Phone flow</text>
                <text class="ux-m" x="36" y="78">Wireframe</text><text class="ux-m" x="292" y="78">UI</text><text class="ux-m" x="548" y="78">Confirmed</text>
                <g class="ux-wire">
                  <rect x="36" y="92" width="224" height="490" /><path d="M56 118h184" /><rect x="56" y="146" width="150" height="20" /><rect x="56" y="176" width="110" height="20" />
                  <rect x="56" y="226" width="184" height="50" /><rect x="56" y="288" width="184" height="50" /><rect x="56" y="350" width="184" height="50" /><rect x="56" y="412" width="184" height="50" />
                  <rect x="56" y="510" width="184" height="48" /><path d="m56 510 184 48m0-48-184 48" />
                </g>
                <rect class="ux-screen" x="292" y="92" width="224" height="490" />
                <path class="ux-track" d="M312 118h184" /><path class="ux-prog" d="M312 118h79" />
                <text class="ux-d ux-w" x="312" y="164">What should the</text><text class="ux-d ux-w" x="312" y="194">site do for you?</text>
                <rect class="t-lime" x="312" y="226" width="184" height="50" /><text class="ux-b ux-k" x="324" y="256">More enquiries</text>
                <g class="ux-opt"><rect x="312" y="288" width="184" height="50" /><rect x="312" y="350" width="184" height="50" /><rect x="312" y="412" width="184" height="50" /></g>
                <text class="ux-b ux-w" x="324" y="318">Sell online</text><text class="ux-b ux-w" x="324" y="380">Look established</text><text class="ux-b ux-w" x="324" y="442">Replace my site</text>
                <rect class="t-lime" x="312" y="510" width="184" height="48" /><text class="ux-b ux-k ux-go" x="404" y="540" text-anchor="middle">Next →</text>
                <rect class="ux-paper" x="548" y="92" width="224" height="490" />
                <circle class="t-lime" cx="590" cy="146" r="22" /><path class="ux-tick" d="m580 146 7 7 13-15" />
                <text class="ux-d ux-k" x="568" y="214">Brief received.</text><text class="ux-d ux-k" x="568" y="244">You’re in</text><text class="ux-d ux-k" x="568" y="274">the queue.</text>
                <g class="ux-rows"><path d="M568 320h184" /><path d="M568 372h184" /><path d="M568 424h184" /></g>
                <text class="ux-m ux-k" x="568" y="352">Package</text><text class="ux-b ux-k" x="752" y="352" text-anchor="end">Growth</text>
                <text class="ux-m ux-k" x="568" y="404">Launch</text><text class="ux-b ux-k" x="752" y="404" text-anchor="end">In a month</text>
                <rect class="ux-dark" x="568" y="510" width="184" height="48" /><text class="ux-b ux-w ux-go" x="660" y="540" text-anchor="middle">Back to site</text>
                <g class="t-link"><path d="M260 337h32" /><path d="M516 337h32" /></g>
                <g class="ux-sel"><rect x="292" y="92" width="224" height="490" /></g>
                <g class="t-lime"><rect x="287" y="87" width="10" height="10" /><rect x="511" y="87" width="10" height="10" /><rect x="287" y="577" width="10" height="10" /><rect x="511" y="577" width="10" height="10" /></g>
                <rect class="t-lime" x="356" y="592" width="96" height="26" /><text class="ux-m ux-k" x="404" y="610" text-anchor="middle">375×812</text>
                <path class="ux-arrow" d="m462 244 0 34 9-8 7 15 8-4-7-14 12-1z" />
                <rect class="ux-panel" x="800" y="46" width="200" height="579" />
                <text class="ux-d ux-w" x="820" y="88">Button</text><text class="ux-m" x="820" y="112">Primary</text>
                <rect class="t-lime" x="820" y="132" width="160" height="48" /><text class="ux-b ux-k ux-go" x="900" y="162" text-anchor="middle">Next →</text>
                <text class="ux-m" x="820" y="226">Fill</text><rect class="t-lime" x="890" y="211" width="20" height="20" /><text class="ux-m ux-hi" x="980" y="226" text-anchor="end">C9FF57</text>
                <text class="ux-m" x="820" y="268">Height</text><text class="ux-m ux-hi" x="980" y="268" text-anchor="end">48</text>
                <text class="ux-m" x="820" y="310">Grid</text><text class="ux-m ux-hi" x="980" y="310" text-anchor="end">24</text>
                <text class="ux-m" x="820" y="352">Contrast</text><text class="ux-m ux-hi" x="980" y="352" text-anchor="end">17:1</text>
                <path class="ux-rule" d="M820 384h160" />
                <text class="ux-m" x="820" y="418">Flow</text><text class="ux-m ux-hi" x="980" y="418" text-anchor="end">7 screens</text>
                <g class="ux-steps">{[0, 1, 2, 3, 4, 5, 6].map((n) => <circle class:list={[{ 'is-on': n < 3 }]} cx={826 + n * 24.6} cy="450" r="6" />)}</g>
              </svg>
            </div><i class="shade"></i></a>
            <a class="plane p-sys" style="--i:4" href={serviceHref(services[4].id)} tabindex="-1" data-i="4"><div class="pl-in">
              <svg class="trip" viewBox="0 0 1000 625"><g transform="translate(-6.5 24)">
                <g class="t-link"><path d="M240 250h44" /><path d="M481 250h44" /><path d="M722 250h44" /></g>
                <g class="t-tip"><path d="m276 238 14 12-14 12" /><path d="m517 238 14 12-14 12" /><path d="m758 238 14 12-14 12" /></g>
                <g class="t-tile"><rect x="50" y="110" width="190" height="280" /><rect x="291" y="110" width="190" height="280" /><rect x="532" y="110" width="190" height="280" /></g>
                <rect class="t-lime" x="773" y="110" width="190" height="280" />
                <g class="t-ink"><rect x="78" y="146" width="134" height="38" /><rect x="78" y="204" width="134" height="38" /><rect x="78" y="262" width="134" height="62" /></g>
                <rect class="t-lime" x="78" y="340" width="86" height="26" rx="13" />
                <rect class="t-lime" x="319" y="146" width="134" height="46" />
                <g class="t-ink"><rect x="319" y="208" width="134" height="46" /><rect x="319" y="270" width="134" height="46" /><path d="M319 350h134" /></g>
                <g class="t-ink"><rect x="562" y="176" width="130" height="96" /><path d="m562 176 65 56 65-56" /></g>
                <circle class="t-lime" cx="692" cy="176" r="19" />
                <path class="t-dark" d="M805 158h126v92h-72l-30 32v-32h-24z" />
                <path class="t-check" d="m838 202 18 18 34-38" />
                <text class="t-word" x="50" y="456">Form</text><text class="t-word" x="291" y="456">Inbox</text><text class="t-word" x="532" y="456">Gmail alert</text><text class="t-word t-word--hot" x="773" y="456">Follow-up</text>
              </g></svg>
            </div><i class="shade"></i></a>
          </div>
          <ol class="layers">
            {services.map((s, i) => (
              <li class="layer" id={`svc-${s.id}`} data-i={i}>
                <h3><a href={serviceHref(s.id)}>{s.short}<span class="sr-only">: {s.title}</span></a></h3>
                <p class="line">{s.line}</p>
                <div class="more">
                  <ul class="mono scope" aria-label={`${s.title} scope`}>{s.scope.map((x) => <li>{x}</li>)}</ul>
                  <a class="mono proof" href={s.proof.href}>See {s.proof.name} <span aria-hidden="true">→</span></a>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- [HOME-04] WORK INDEX -->
    <section class="section work" id="work" data-f="work" aria-labelledby="work-h">
      <div class="container">
        <p class="mono rv">Selected work · {String(caseIndex.length).padStart(2, '0')} cases · {String(countries.length).padStart(2, '0')} countries</p>
        <h2 id="work-h" class="t-d2 rv">Work that’s live, not just pretty.</h2>
        <p class="work-intro rv">Every project below is a real business running on what we built. Open the live sites on your phone. That’s the test.</p>
        <FeaturedWork />
        <p class="mono work-more rv">More cases</p>
        <WorkIndex skip={FEATURED} />
        <a class="btn btn--ghost" href="/work">See all the work</a>
      </div>
    </section>

    <!-- [HOME-04b] LAB: the concept series, drawn by the field as the same dot contact sheet as /lab -->
    <section class="section hlab" id="lab" data-f="slate" aria-labelledby="lab-h">
      <div class="container hlab-in">
        <div class="hlab-copy">
          <p class="mono rv">Fazed Lab · {pad2(labShipped.length)} of {LAB_TOTAL} concept sites shipped</p>
          <h2 id="lab-h" class="hlab-h rv"><span>Our lab.</span> <span>Your next site.</span></h2>
          <p class="hlab-deck rv">Immersive 3D sites for brands that don’t exist, built to test what we’ll build for brands that do.</p>
          <ol class="hlab-list rv" aria-label="Newest concept sites">
            {labNew.map((i) => (
              <li><a href={i.url} target="_blank" rel="noopener" data-cursor="OPEN ↗">
                <span class="mono hlab-n">{i.n}</span>
                <span class="hlab-t"><b>{i.brand}</b><span class="mono">{i.category} · {LABEL}</span></span>
                <span class="hlab-go" aria-hidden="true">↗</span><span class="sr-only"> (opens the live concept site in a new tab)</span>
              </a></li>
            ))}
          </ol>
          <a class="btn btn--lime rv" href="/lab" data-magnetic>Explore the Lab <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <LabSheetPoster linkBase="/lab" />
      </div>
    </section>

    <!-- [HOME-05] FLOOD -->
    <section class="flood on-lime" id="flood" data-f="flood" aria-labelledby="flood-h">
      <div class="container flood-in">
        <p class="mono flood-eye">Fast-track · Fixed price</p>
        <h2 id="flood-h" class="t-mega flood-h">Live in <span>7 days.</span></h2>
        <p class="flood-body">A custom, mobile-ready, SEO-set-up website for your small business. Designed, built and launched in one week, at a fixed price you know upfront.</p>
        <ol class="days" aria-label="The 7-day timeline">
          {days.map((d, i) => <li class="day" data-day={i}><span class="day-node" aria-hidden="true"></span><span class="mono">{d}</span></li>)}
        </ol>
        <ul class="flood-chips" aria-label="Packages">
          <li class="chip">Starter $499</li><li class="chip">Growth $899</li><li class="chip">Pro $1,499</li>
        </ul>
        <p class="flood-honest">Seven days works when your content and feedback arrive on time. We’ll tell you exactly what we need on Day 1.</p>
        <div class="flood-cta">
          <a class="btn btn--black" href="/lp/7-day-website" data-magnetic>Get live in 7 days <span class="arrow" aria-hidden="true">→</span></a>
          <a class="flood-link" href="/lp/7-day-website/ph">See peso pricing (₱19,999+)</a>
        </div>
      </div>
    </section>

    <!-- [HOME-06] PROCESS -->
    <section class="section process" id="process" data-f="path4" aria-labelledby="proc-h">
      <div class="container">
        <p class="mono rv">How we work · 04 steps</p>
        <h2 id="proc-h" class="t-d2 rv">Questions first. Pixels second.</h2>
        <ol class="steps" data-path-anchor>
          {steps.map(([n, t, b]) => <li class="step rv"><span class="mono step-n">{n}</span><h3 class="t-h3">{t}</h3><p>{b}</p></li>)}
        </ol>
        <p class="mono rv">You own everything · No lock-in · <a class="link proc-lab" href="/lab">The engine behind it: Fazed Lab →</a></p>
      </div>
    </section>

    <!-- [HOME-07] CONNECTIONS -->
    <section class="section conn" id="connections" data-f="globe" aria-labelledby="conn-h" data-arcs={JSON.stringify(arcDests)}>
      <div class="container conn-in">
        <div class="conn-globe" data-globe aria-hidden="true">
          <svg class="poster-art conn-poster" viewBox="0 0 200 200"><defs><pattern id="gd" width="4" height="4" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r=".9" fill="#F5F4F0" fill-opacity=".35" /></pattern></defs><circle cx="100" cy="100" r="96" fill="url(#gd)" /><circle cx="100" cy="100" r="96" fill="none" stroke="#2A2A2A" /></svg>
        </div>
        <div class="conn-text">
          <p class="mono rv">Connections · Iligan → USA · Australia · Philippines</p>
          <h2 id="conn-h" class="t-d1 rv">One studio. <span class="dim">Many time zones.</span></h2>
          <ul class="results">
            {results.map((r) => <li class="result rv"><p class="mono">{r.tag}</p><h3 class="t-h3">{r.statement}</h3><p>{r.body}</p><a class="link" href={r.link.href}>{r.link.label}</a></li>)}
          </ul>
          <p class="mono conn-count">{String(caseIndex.length).padStart(2, '0')} cases · {String(countries.length).padStart(2, '0')} countries · Est. 2022</p>
        </div>
      </div>
      <div class="container">
        <dl class="stats">
          {stats.filter((s) => s.show).map((s) => <div class="stat rv"><dt class="mono">{s.label}</dt><dd><span class="stat-v">{s.value}{s.suffix}</span><span class="mono">{s.sub}</span></dd></div>)}
        </dl>
      </div>
    </section>

    <!-- [HOME-08] PEOPLE -->
    <section class="section people" id="people" data-f="rings" aria-labelledby="ppl-h">
      <div class="container people-in">
        <div>
          <p class="mono rv">The team · 04 people · 01 city</p>
          <h2 id="ppl-h" class="t-d2 rv">Four people. No hand-offs.</h2>
          <p class="rv people-intro">The people who pitch your project are the people who build it. You talk to us directly, not to an account manager.</p>
          <a class="link" href="/about">Meet the studio</a>
        </div>
        <ul class="ppl" data-rings-anchor>
          {team.map((p, i) => (
            <li class="person rv" tabindex="0" data-person={i}>
              {p.photo ? <img class="person-img" src={p.photo} alt={`Portrait of ${p.name}, ${p.role} at Fazed Digital`} width="96" height="96" loading="lazy" decoding="async" /> : <span class="person-init mono" aria-hidden="true">{p.initials}</span>}
