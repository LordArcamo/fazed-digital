---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MarkPoster from '../components/MarkPoster.astro';
import Glyph from '../components/Glyph.astro';
import ContactForm from '../components/ContactForm.astro';
import WorkIndex from '../components/WorkIndex.astro';
import LabSheetPoster from '../components/LabSheetPoster.astro';
import { labShipped, LAB_TOTAL, LABEL, pad2 } from '../data/lab';
import { services } from '../data/services';
import { homeFaq } from '../data/home';
import Faq from '../components/Faq.astro';
import { faqPage } from '../lib/schema';
import { caseIndex, countries } from '../data/cases';
import { stats, results, capsCopy } from '../data/proof';
import { team } from '../data/team';
import { workImages } from '../data/images';
import { NAP, SITE_URL } from '../data/site';

const cols = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
const days = ['Day 1 · Brief', 'Day 2 · Design', 'Day 3 · Design', 'Day 4 · Build', 'Day 5 · Build', 'Day 6 · Review', 'Day 7 · Launch'];
const steps = [
  ['01', 'Discover', 'We learn your business, your market and your customers. No guessing, just the right questions.'],
  ['02', 'Strategy', 'The answers become a plan: structure, message and a brief every later decision points back to.'],
  ['03', 'Design', 'Every visual and every word, from logo to layout, with the detail most people only feel.'],
  ['04', 'Launch', 'We ship, measure and fix. You get the keys: domain, hosting, logins and files, all in your name.'],
];
// Lab feature: the newest three concept sites, newest first (#04 Halde stays off sales pages: CC BY-NC base model)
const labNew = labShipped.filter((i) => i.n !== '04' && i.url).reverse().slice(0, 3);
// arcs: Iligan → each distinct client location (from cases.ts only)
const arcDests = [...new Map(caseIndex.filter((c) => Math.hypot(c.lat - 8.23, c.lon - 124.24) > 1).map((c) => [`${c.lat},${c.lon}`, [c.lat, c.lon]])).values()];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Fazed Digital case studies',
    itemListElement: caseIndex.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: `${SITE_URL}/work/${c.slug}` })),
  },
  faqPage(homeFaq),
];
---
<Base
  title="Web Design & Branding Studio in the Philippines | Fazed"
  description="Custom websites, brands, SEO and web apps from Iligan City, Philippines, for businesses in the USA, Australia and the Philippines. 7-day sites from $499."
  formation="mark"
  schema={schema}
  current="/"
>
  <div data-page="home">
    <!-- [HOME-01] MARK -->
    <section class="hero" id="top" data-f="mark" aria-labelledby="hero-h">
      <MarkPoster />
      <div class="container hero-in">
        <p class="mono hero-strip"><span class="hs-d">Iligan City, PH · {NAP.coords} · Est. 2022</span><span class="hs-m" aria-hidden="true">Iligan, PH · {NAP.coords.split(" N")[0]} N · Est. 2022</span></p>
        <h1 id="hero-h" class="hero-h"><span class="hero-l1">Built in Iligan.</span> <span class="hero-l2">Live worldwide.</span></h1>
        <p class="t-body-l hero-deck">Websites, brands and web apps for owners who want to be found, trusted and chosen. Made in the Philippines, shipped to the USA, Australia and home.</p>
        <div class="hero-cta">
          <a class="btn btn--lime" href="/contact" data-magnetic data-cursor="GO →">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/work">See the work</a>
        </div>
        <p class="mono hero-cue" aria-hidden="true">Scroll · 01 / 09</p>
      </div>
    </section>

    <!-- [HOME-02] UNFOLD -->
    <section class="section unfold" id="unfold" data-f="lattice" aria-labelledby="unfold-h">
      <div class="ruler container" aria-hidden="true">{cols.map((c) => <span class="mono" data-c={c}></span>)}<span class="mono ruler-pitch"></span></div>
      <div class="container unfold-in">
        <h2 id="unfold-h" class="t-d1 rv">Web design, branding <span class="dim">and SEO from the Philippines.</span></h2>
        <p class="mono rv">Shipping to USA · Australia · Philippines since 2022</p>
        <div class="unfold-body">
          <p class="t-body-l rv">Fazed Digital is a small studio in <a class="link" href="/web-design-iligan-city">Iligan City</a>, Mindanao. We design and build the websites, brand systems and custom tools that small and mid-sized businesses run on, from a framing contractor in Utah to a law firm in Queensland.</p>
          <p class="rv">Every project starts with the same three questions: who are you, who are you talking to, and what do you want them to feel? The answers shape everything that follows.</p>
        </div>
      </div>
    </section>

    <!-- [HOME-03] SERVICES -->
    <section class="services" id="services" data-f="pentagon" aria-labelledby="svc-h">
      <div class="svc-pin">
        <div class="container svc-in">
          <div class="svc-head">
            <p class="mono">What we do · 05 services</p>
            <h2 id="svc-h" class="t-d2">Five services. One connected system.</h2>
            <p class="svc-intro">Hire us for one, or let them work together. Brand feeds the site, the site feeds search, search feeds the business.</p>
            <div class="svc-steps" role="group" aria-label="Step through the five services">
              {services.map((s, i) => <button type="button" class="svc-step" data-step={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`svc-${s.id}`}><span class="sr-only">Show </span>{s.n}<span class="sr-only"> {s.title}</span></button>)}
            </div>
          </div>
          <ol class="svc-list">
            {services.map((s, i) => (
              <li class="svc" id={`svc-${s.id}`} data-i={i}>
                <Glyph id={s.id} size={56} />
                <div class="svc-body">
                  <p class="mono svc-n">Node {s.n}/05</p>
                  <h3 class="t-h3 svc-t"><a href={`/services#${s.id}`}>{s.title}</a></h3>
                  <p class="svc-line">{s.line}</p>
                  <ul class="svc-scope mono" aria-label={`${s.title} scope`}>{s.scope.map((x) => <li>{x}</li>)}</ul>
                  <a class="mono svc-proof link" href={s.proof.href}>{s.proof.label} <span class="sr-only">{s.proof.name}</span></a>
                </div>
              </li>
            ))}
          </ol>
          <a class="btn btn--ghost svc-all" href="/services">See all five services</a>
        </div>
      </div>
    </section>

    <!-- [HOME-04] WORK INDEX -->
    <section class="section work" id="work" data-f="work" aria-labelledby="work-h">
      <div class="container">
        <p class="mono rv">Selected work · {String(caseIndex.length).padStart(2, '0')} cases · {String(countries.length).padStart(2, '0')} countries</p>
        <h2 id="work-h" class="t-d2 rv">Work that’s live, not just pretty.</h2>
        <p class="work-intro rv">Every project below is a real business running on what we built. Open the live sites on your phone. That’s the test.</p>
        <WorkIndex />
        <a class="btn btn--ghost" href="/work">See all the work</a>
      </div>
    </section>

    <!-- [HOME-04b] LAB: the concept series, drawn by the field as the same dot contact sheet as /lab -->
    <section class="section hlab" id="lab" data-f="slate" aria-labelledby="lab-h">
      <div class="container hlab-in">
        <div class="hlab-copy">
          <p class="mono rv">Fazed Lab · {pad2(labShipped.length)} of {LAB_TOTAL} concept sites shipped</p>
          <h2 id="lab-h" class="hlab-h rv"><span>Our lab.</span> <span>Your next site.</span></h2>
          <p class="hlab-deck rv">Immersive 3D sites for brands that don’t exist, built to test what we’ll build for brands that do.</p>
          <ol class="hlab-list rv" aria-label="Newest concept sites">
            {labNew.map((i) => (
              <li><a href={i.url} target="_blank" rel="noopener" data-cursor="OPEN ↗">
                <span class="mono hlab-n">{i.n}</span>
                <span class="hlab-t"><b>{i.brand}</b><span class="mono">{i.category} · {LABEL}</span></span>
                <span class="hlab-go" aria-hidden="true">↗</span><span class="sr-only"> (opens the live concept site in a new tab)</span>
              </a></li>
            ))}
          </ol>
          <a class="btn btn--lime rv" href="/lab" data-magnetic>Explore the Lab <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <LabSheetPoster linkBase="/lab" />
      </div>
    </section>

    <!-- [HOME-05] FLOOD -->
    <section class="flood on-lime" id="flood" data-f="flood" aria-labelledby="flood-h">
      <div class="container flood-in">
        <p class="mono flood-eye">Fast-track · Fixed price</p>
        <h2 id="flood-h" class="t-mega flood-h">Live in <span>7 days.</span></h2>
        <p class="flood-body">A custom, mobile-ready, SEO-set-up website for your small business. Designed, built and launched in one week, at a fixed price you know upfront.</p>
        <ol class="days" aria-label="The 7-day timeline">
          {days.map((d, i) => <li class="day" data-day={i}><span class="day-node" aria-hidden="true"></span><span class="mono">{d}</span></li>)}
        </ol>
        <ul class="flood-chips" aria-label="Packages">
          <li class="chip">Starter $499</li><li class="chip">Growth $899</li><li class="chip">Pro $1,499</li>
        </ul>
        <p class="flood-honest">Seven days works when your content and feedback arrive on time. We’ll tell you exactly what we need on Day 1.</p>
        <div class="flood-cta">
          <a class="btn btn--black" href="/lp/7-day-website" data-magnetic>Get live in 7 days <span class="arrow" aria-hidden="true">→</span></a>
          <a class="flood-link" href="/lp/7-day-website/ph">See peso pricing (₱19,999+)</a>
        </div>
      </div>
    </section>

    <!-- [HOME-06] PROCESS -->
    <section class="section process" id="process" data-f="path4" aria-labelledby="proc-h">
      <div class="container">
        <p class="mono rv">How we work · 04 steps</p>
        <h2 id="proc-h" class="t-d2 rv">Questions first. Pixels second.</h2>
        <ol class="steps" data-path-anchor>
          {steps.map(([n, t, b]) => <li class="step rv"><span class="mono step-n">{n}</span><h3 class="t-h3">{t}</h3><p>{b}</p></li>)}
        </ol>
        <p class="mono rv">You own everything · No lock-in · <a class="link proc-lab" href="/lab">The engine behind it: Fazed Lab →</a></p>
      </div>
    </section>

    <!-- [HOME-07] CONNECTIONS -->
    <section class="section conn" id="connections" data-f="globe" aria-labelledby="conn-h" data-arcs={JSON.stringify(arcDests)}>
      <div class="container conn-in">
        <div class="conn-globe" data-globe aria-hidden="true">
          <svg class="poster-art conn-poster" viewBox="0 0 200 200"><defs><pattern id="gd" width="4" height="4" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r=".9" fill="#F5F4F0" fill-opacity=".35" /></pattern></defs><circle cx="100" cy="100" r="96" fill="url(#gd)" /><circle cx="100" cy="100" r="96" fill="none" stroke="#2A2A2A" /></svg>
        </div>
        <div class="conn-text">
          <p class="mono rv">Connections · Iligan → USA · Australia · Philippines</p>
          <h2 id="conn-h" class="t-d1 rv">One studio. <span class="dim">Many time zones.</span></h2>
          <ul class="results">
            {results.map((r) => <li class="result rv"><p class="mono">{r.tag}</p><h3 class="t-h3">{r.statement}</h3><p>{r.body}</p><a class="link" href={r.link.href}>{r.link.label}</a></li>)}
          </ul>
          <p class="mono conn-count">{String(caseIndex.length).padStart(2, '0')} cases · {String(countries.length).padStart(2, '0')} countries · Est. 2022</p>
        </div>
      </div>
      <div class="container">
        <dl class="stats">
          {stats.filter((s) => s.show).map((s) => <div class="stat rv"><dt class="mono">{s.label}</dt><dd><span class="stat-v">{s.value}{s.suffix}</span><span class="mono">{s.sub}</span></dd></div>)}
        </dl>
      </div>
    </section>

    <!-- [HOME-08] PEOPLE -->
    <section class="section people" id="people" data-f="rings" aria-labelledby="ppl-h">
      <div class="container people-in">
        <div>
          <p class="mono rv">The team · 04 people · 01 city</p>
          <h2 id="ppl-h" class="t-d2 rv">Four people. No hand-offs.</h2>
          <p class="rv people-intro">The people who pitch your project are the people who build it. You talk to us directly, not to an account manager.</p>
          <a class="link" href="/about">Meet the studio</a>
        </div>
        <ul class="ppl" data-rings-anchor>
          {team.map((p, i) => (
            <li class="person rv" tabindex="0" data-person={i}>
              {p.photo ? <img class="person-img" src={p.photo} alt={`Portrait of ${p.name}, ${p.role} at Fazed Digital`} width="96" height="96" loading="lazy" decoding="async" /> : <span class="person-init mono" aria-hidden="true">{p.initials}</span>}
              <div><h3 class="person-n">{p.name}</h3><p class="mono">{p.role}</p><p class="person-l">{p.line}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- [HOME-08b] FAQ: the questions owners ask first (visible copy == FAQPage JSON-LD) -->
    <section class="section hfaq" id="faq" data-f="lattice" aria-labelledby="hfaq-h">
      <div class="container hfaq-in">
        <div>
          <p class="mono rv">FAQ · {String(homeFaq.length).padStart(2, '0')}</p>
          <h2 id="hfaq-h" class="t-d2 rv">Questions owners ask first</h2>
          <a class="link" href="/services#faq">More answers</a>
        </div>
        <Faq items={homeFaq} id="hfaq" />
      </div>
    </section>

    <!-- [HOME-09] CONTACT NODE -->
    <section class="section contact" id="contact" data-f="node" aria-labelledby="ct-h">
      <div class="container contact-in">
        <div class="contact-text">
          <p class="mono">{NAP.coords} · Mon–Fri 8:30am–5:00pm PHT</p>
          <h2 id="ct-h" class="t-d1">Your move. <span class="dim">Send the brief.</span></h2>
          <p class="t-body-l">Tell us what you’re building and when you need it. We’ll reply within one business day with next steps, not a sales script.</p>
          <p class="mono contact-cap">{capsCopy.custom}</p>
          <ul class="contact-lines">
            <li><span class="mono">Email</span><a class="link" href={`mailto:${NAP.email}`} aria-label={`Email Fazed Digital at ${NAP.email}`}>{NAP.email}</a></li>
            <li><span class="mono">Phone</span><a class="link" href={`tel:${NAP.tel}`} aria-label={`Call Fazed Digital on ${NAP.phone}`}>{NAP.phone}</a></li>
            <li><span class="mono">Hours</span><span>Mon–Fri, 8:30am–5:00pm (Philippine time)</span></li>
            <li><span class="mono">Studio</span><span>Iligan City, Lanao del Norte, Philippines</span></li>
          </ul>
          <span class="node-anchor" data-node-anchor aria-hidden="true"></span>
        </div>
        <ContactForm id="home-cf" />
      </div>
    </section>
  </div>
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: clip; }
  .hero-in { position: relative; z-index: 1; padding-top: calc(var(--header-h) + 24px); padding-bottom: 72px; }
  .hero-strip { margin-bottom: 1.75rem; white-space: nowrap; }
  .hs-m { display: none; }
  .hero-h { font-size: clamp(3rem, 6.5vw, 7rem); line-height: .88; letter-spacing: -.035em; font-weight: 600; max-width: 60%; }
  .hero-l1, .hero-l2 { display: block; white-space: nowrap; }
  .hero-l2 { color: var(--gray-400); }
  .hero-deck { max-width: 36ch; margin-top: 2rem; }
  .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2.25rem; }
  .hero-cue { position: absolute; bottom: 24px; left: var(--side); }
  @media (max-width: 1023px) {
    /* column: the mark (MarkPoster) grows into the space above the copy */
    .hero { flex-direction: column; align-items: stretch; justify-content: flex-end; min-height: var(--screen-h, 100svh); }
    /* SIGNAL DOCK: CTAs clear the 64px mobile dock (+12px inset) with air to spare */
    .hero-in { padding-top: 20px; padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
    .hero-h { font-size: clamp(2.4rem, 11.6vw, 4.6rem); max-width: none; }
    .hero-strip { margin-bottom: .75rem; font-size: .7rem; letter-spacing: .1em; }
    .hs-d { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } .hs-m { display: inline; }
    .hero-deck { margin-top: 1rem; font-size: 1.0625rem; }
    .hero-cta { margin-top: 1.5rem; }
    /* short phone screens (Chrome/Safari with toolbars): a touch tighter so the mark keeps its size */
    @media (max-height: 800px) { .hero-deck { font-size: 1rem; line-height: 1.45; } .hero-strip { margin-bottom: .6rem; } }
    .hero-cue { display: none; }
    .hero-cta { flex-wrap: nowrap; gap: .5rem; } .hero-cta .btn { padding: 0 1rem; }
  }

  /* UNFOLD */
  .unfold { overflow: clip; }
  .ruler { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); margin-bottom: 96px; position: relative; }
  .ruler span { font-size: .625rem; border-left: 1px solid var(--gray-700); padding-left: .4rem; color: var(--gray-400); }
  .ruler .ruler-pitch { position: absolute; right: var(--side); top: 1.5rem; border: 0; }
  /* the labels are drawn by CSS so text extractors and AI crawlers don't read "Col 01 … Pitch 24px" as page copy */
  .ruler span::before { content: 'Col ' attr(data-c); }
  .ruler .ruler-pitch::before { content: 'Pitch 24px'; }
  .unfold-in { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 2rem; }
  .unfold-in h2 { grid-column: 1 / span 11; }
  .unfold-in > .mono { grid-column: 1 / span 6; }
  .unfold-body { grid-column: 7 / span 6; display: grid; gap: 1.25rem; }
  @media (max-width: 1023px) { .ruler { grid-template-columns: repeat(4, 1fr); } .ruler span:nth-child(n + 5):not(.ruler-pitch) { display: none; } .unfold-in > * { grid-column: 1 / -1 !important; } }

  /* SERVICES */
  .services { position: relative; }
  .svc-pin { padding-block: var(--section); }
  .svc-in { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 3rem; }
  .svc-head { grid-column: 1 / span 5; display: grid; gap: 1.25rem; align-content: start; }
  .svc-intro { max-width: 40ch; }
  .svc-steps { display: none; gap: .5rem; }
  .svc-step { min-width: 48px; min-height: 48px; border-radius: 999px; border: 1px solid var(--gray-700); font-family: var(--font-mono); font-size: .8rem; color: var(--gray-300); }
  .svc-step[aria-pressed='true'] { background: var(--lime); color: var(--black); border-color: var(--lime); }
  @media (max-width: 1023px) { .svc-head { grid-column: 1 / -1; } }
  .svc-list { grid-column: 1 / -1; display: grid; gap: 0; border-top: 1px solid var(--gray-700); }
  .svc { display: flex; gap: 1.5rem; padding: 2rem 0; border-bottom: 1px solid var(--gray-700); }
  .svc-body { display: grid; gap: .6rem; }
  .svc-t a:hover { color: var(--lime); }
  .svc-scope { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; color: var(--gray-300); }
  .svc-scope li::before { content: '· '; color: var(--lime); }
  .svc-proof { justify-self: start; display: inline-flex; align-items: center; min-height: 44px; color: var(--lime); text-decoration: none; }
  .svc-proof:hover, .svc-proof:focus-visible { color: var(--black); }
  .svc-all { grid-column: 1 / -1; justify-self: start; }
  /* desktop pinned mode (motion adds .svc-live): one node at a time, left column */
  @media (min-width: 1024px) {
    :global(html.js-motion:not(.rm)) .svc-live .svc-pin { min-height: 100vh; display: flex; align-items: center; padding-block: calc(var(--header-h) + 24px) 48px; }
    :global(html.js-motion:not(.rm)) .svc-live .svc-steps { display: flex; }
    :global(html.js-motion:not(.rm)) .svc-live .svc-list { grid-column: 1 / span 5; position: relative; border: 0; min-height: 300px; }
    :global(html.js-motion:not(.rm)) .svc-live .svc { position: absolute; inset: 0 0 auto 0; border: 0; opacity: 0; visibility: hidden; transform: translateY(16px); transition: opacity .45s var(--ease-out), transform .45s var(--ease-out), visibility 0s .45s; }
    :global(html.js-motion:not(.rm)) .svc-live .svc.is-on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
    :global(html.js-motion:not(.rm)) .svc-live .svc .t-h3 { font-size: var(--fs-d2); line-height: .95; }
    :global(html.gl-live) .svc-live .svc :global(.glyph) { display: none; }
  }

  /* WORK INDEX */
  .work .t-d2 { margin: 1rem 0; }
  .work-intro { max-width: 52ch; margin-bottom: 3rem; }

  /* Lab feature: copy + newest three on the left, the dot contact sheet on the right (same as the /lab hero) */
  .hlab-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3rem var(--gutter); align-items: center; }
  .hlab-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .hlab-h { font-size: clamp(2.5rem, 4.6vw, 4.5rem); line-height: .95; letter-spacing: -.03em; }
  .hlab-h span { display: block; } .hlab-h span + span { color: var(--gray-400); }
  .hlab-deck { max-width: 44ch; }
  .hlab-list { width: 100%; border-top: 1px solid var(--gray-700); }
  .hlab-list a { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto; align-items: center; gap: 1rem; min-height: 64px; padding-block: 12px; border-bottom: 1px solid var(--gray-700); transition: background-color .2s, padding .3s var(--ease-out); }
  .hlab-n { color: var(--lime); }
  .hlab-t { display: grid; gap: .2rem; }
  .hlab-t b { font-weight: 600; }
  .hlab-t .mono { font-size: 11px; letter-spacing: .1em; color: var(--gray-400); }
  .hlab-go { color: var(--gray-400); transition: color .2s, transform .3s var(--ease-out); }
  .hlab-list a:hover, .hlab-list a:focus-visible { padding-inline: 12px; background: var(--gray-900); }
  .hlab-list a:hover .hlab-go, .hlab-list a:focus-visible .hlab-go { color: var(--lime); transform: translate(2px, -2px); }
  .hlab :global(.slate) { justify-self: end; width: min(606px, 46vw); }
  @media (max-width: 1023px) {
    .hlab-in { grid-template-columns: 1fr; }
    .hlab :global(.slate) { justify-self: stretch; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .hlab-list a, .hlab-go { transition: none; } }
