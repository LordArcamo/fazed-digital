---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { cases, caseIndex } from '../../data/cases';
import { workImages } from '../../data/images';
import { CASE_METRICS_REAL } from '../../data/proof';
import { SITE_URL } from '../../data/site';
import { crumbs, faqPage, ORG_REF } from '../../lib/schema';
import { caseSeo } from '../../data/case-seo';
import Faq from '../../components/Faq.astro';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}
const { slug } = Astro.props;
const c = caseIndex.find((x) => x.slug === slug)!;
const i = caseIndex.findIndex((x) => x.slug === slug);
const next = caseIndex[(i + 1) % caseIndex.length];
const img = workImages[slug];
// LCP: the hero plate is preloaded with the same avif srcset the <Picture> emits (same widths + quality → same URLs)
const HERO_W = [480, 680, 1000, 1600], HERO_Q = 55, HERO_SIZES = '(max-width: 1340px) 92vw, 1212px';
const lcp = await getImage({ src: img, format: 'avif', widths: HERO_W, quality: HERO_Q });
// fresh full-page captures of the live sites (scripts/capture-cases.mjs, user OK'd 2026-10-16)
const platesAll = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/plates/*.jpg', { eager: true });
const plate = (k: string) => platesAll[`../../assets/work/plates/${slug}-${k}.jpg`]?.default;
const plateD = plate('desktop'), plateM = plate('mobile');
const countryCode: Record<string, string> = { USA: 'US', Australia: 'AU', Philippines: 'PH' };
const seo = caseSeo[slug];
const where = c.region ? `${c.region}, ${c.country}` : c.country;
// related: two other cases that share a discipline (then the rest), in index order
const related = caseIndex.filter((x) => x.slug !== slug).sort((a, b) => Number(b.discipline.some((d) => (c.discipline as string[]).includes(d))) - Number(a.discipline.some((d) => (c.discipline as string[]).includes(d)))).slice(0, 2);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${SITE_URL}/work/${slug}#case`,
    name: `${c.title} case study`,
    headline: seo ? `${c.title}: ${seo.h1Tail}` : c.resultHeadline,
    description: seo?.summary ?? c.seoDescription,
    url: `${SITE_URL}/work/${slug}`,
    image: `${SITE_URL}/og/work/${slug}.png`,
    creator: ORG_REF,
    dateCreated: c.year,
    genre: c.category,
    keywords: [seo?.kw, ...c.services, ...(seo?.stack ?? [])].filter(Boolean).join(', '),
    about: { '@type': 'Organization', name: c.client, ...(c.liveLabel ? { url: c.liveUrl } : {}), address: { '@type': 'PostalAddress', addressCountry: countryCode[c.country] ?? c.country, ...(c.region ? { addressRegion: c.region } : {}) } },
    isPartOf: { '@type': 'CollectionPage', '@id': `${SITE_URL}/work`, name: 'Fazed Digital case studies' },
    mainEntityOfPage: `${SITE_URL}/work/${slug}`,
    locationCreated: { '@type': 'Place', name: 'Iligan City, Philippines' },
    countryOfOrigin: { '@type': 'Country', name: 'Philippines' },
    spatialCoverage: { '@type': 'Country', name: c.country, ...(countryCode[c.country] ? { identifier: countryCode[c.country] } : {}) },
  },
  ...(seo?.faq.length ? [faqPage(seo.faq)] : []),
  crumbs([['Work', '/work'], [c.title, `/work/${slug}`]]),
];
const [lead, ...restSentences] = c.resultCopy[0].split(/(?<=\.)\s+/);
const resultBody = [restSentences.join(' '), ...c.resultCopy.slice(1)].filter(Boolean);
const facts: [string, string][] = [['Client', c.client], ['Location', where], ['Industry', c.industry], ['What we built', c.built], ['Services', c.services.join(', ')], ...(seo?.stack.length ? [['Built with', seo.stack.join(', ')] as [string, string]] : []), ['Duration', c.duration], ['Year', c.year]];
---
<Base title={seo?.seoTitle ?? c.seoTitle} description={seo?.seoDescription ?? c.seoDescription} image={`/og/work/${slug}.png`} formation="shot" schema={schema} current="/work">
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={lcp.srcSet.attribute} imagesizes={HERO_SIZES} fetchpriority="high" />
  <article class="case" data-case={slug}>
    <header class="c-hero container">
      <nav class="crumbs mono" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/work">Work</a></li><li aria-current="page">{c.title}</li></ol></nav>
      <p class="mono c-strip">{c.strip}</p>
      <h1 class="c-h1-wrap"><span class="t-d1 c-h1">{c.title}</span>{seo && <span class="c-h1-k">{seo.h1Tail}</span>}</h1>
      <p class="t-d2 c-sub">{c.resultHeadline}</p>
      {seo && <p class="t-body-l c-sum">{seo.summary}</p>}
      <div class="c-actions">
        {c.liveLabel ? <a class="btn btn--lime" href={c.liveUrl} target="_blank" rel="noopener" data-cursor="OPEN ↗">{c.liveLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a> : <span class="chip c-priv">Private system · shown with permission</span>}
        <a class="btn btn--ghost" href="/work">← All work</a>
      </div>
    </header>
    <figure class="c-shot container" data-f="shot" data-shot={slug}>
      <div class="c-shot-frame" data-shot-rect>
        <Picture src={img} formats={['avif', 'webp']} widths={HERO_W} quality={HERO_Q} sizes={HERO_SIZES} alt={c.alt} loading="eager" fetchpriority="high" decoding="async" class="c-img" />
        <span class="c-scan" aria-hidden="true"></span>
      </div>
    </figure>

    <section class="section c-result container" data-f="lattice" aria-labelledby="r-h">
      <p class="mono">The result</p>
      <h2 id="r-h" class="t-d2 c-result-h">{lead}</h2>
      {resultBody.map((p) => <p class="t-body-l c-result-b">{p}</p>)}
      {!CASE_METRICS_REAL && <p class="c-metric mono" data-placeholder>Result metric coming soon · we only publish numbers the client has confirmed</p>}
      <dl class="c-facts">
        {facts.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
        <div><dt class="mono">Live site</dt><dd>{c.liveLabel ? <a class="link" href={c.liveUrl} target="_blank" rel="noopener">{c.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗<span class="sr-only"> (opens in a new tab)</span></a> : 'Private system'}</dd></div>
      </dl>
    </section>

    <section class="section c-story container" aria-label="Challenge and approach">
      <div><h2 class="mono">The challenge</h2><p class="c-article">{c.challengeCopy}</p></div>
      <div><h2 class="mono">What we built</h2><p class="c-article">{c.approachCopy}</p></div>
    </section>

    <section class="section c-plate container" aria-label="Project screens">
      <div class:list={['c-plates', { 'c-plates--m': !!plateM }]}>
        <div class="browser" data-plate>
          <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span class="mono">{c.liveLabel ? c.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') : 'private system'}</span></div>
          <div class="browser-view"><Picture src={plateD ?? img} formats={['avif', 'webp']} widths={[800, 1200, 1440]} sizes="(max-width: 1023px) 92vw, 900px" alt={plateD ? `Full-page capture of ${c.title}'s live site, desktop` : c.alt} loading="lazy" decoding="async" class="plate-img" /></div>
        </div>
        {plateM && (
          <div class="phone" data-plate>
            <div class="browser-view"><Picture src={plateM} formats={['avif', 'webp']} widths={[390, 780]} sizes="300px" alt={`Full-page capture of ${c.title}'s live site on a phone`} loading="lazy" decoding="async" class="plate-img" /></div>
          </div>
        )}
      </div>
      {plateD && <p class="mono c-cap">Captured from the live site, Oct 2026</p>}
    </section>

    <section class="section c-out container" data-f="lattice" aria-labelledby="o-h">
      <h2 id="o-h" class="mono">Outcomes</h2>
      <ol class="c-nodes">{c.outcomesCopy.map((o, k) => <li class="rv"><span class="c-node" aria-hidden="true"></span><span class="mono">0{k + 1}</span><p>{o}</p></li>)}</ol>
      <div class="c-svcs"><h2 class="mono">Services used</h2><ul>{c.servicesUsed.map((x) => <li><a class="link" href={x.href}>{x.label}</a></li>)}</ul></div>
    </section>

    {seo && seo.faq.length > 0 && (
      <section class="section c-faq container" aria-labelledby="cf-h">
        <h2 id="cf-h" class="mono">Questions about this project</h2>
        <Faq items={seo.faq} id={`case-${slug}-faq`} />
      </section>
    )}

    <section class="section c-rel container" aria-labelledby="rel-h">
      <h2 id="rel-h" class="mono">Related</h2>
      <ul class="c-rel-cases">{related.map((x) => (
        <li class="rv"><a href={`/work/${x.slug}`}>
          <Picture src={workImages[x.slug]} formats={['avif', 'webp']} widths={[480, 800]} sizes="(max-width: 767px) 92vw, 40vw" alt={x.alt} loading="lazy" decoding="async" />
          <span class="mono">Case {x.slug} · {x.sector} · {x.country}</span><b>{x.title}</b><span>{x.changed}</span>
        </a></li>
      ))}</ul>
      {seo && seo.related.length > 0 && <ul class="c-rel-links">{seo.related.map((r) => <li><a class="link" href={r.href}>{r.label} →</a></li>)}</ul>}
    </section>

    <section class="section c-cta container" data-f="node" aria-labelledby="cta-h">
      <span class="node-anchor" data-node-anchor aria-hidden="true"></span>
      <h2 id="cta-h" class="t-d1">Want results like these?</h2>
      <p class="t-body-l">Tell us where you’re stuck. We’ll tell you honestly whether we’re the right fit.</p>
      <div class="c-btns"><a class="btn btn--lime" href="/contact" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a><a class="btn btn--ghost" href="/work">More work</a></div>
    </section>

    <nav class="c-next container" aria-label="Next case">
      <a href={`/work/${next.slug}`} class="c-next-a" data-cursor={`CASE ${next.slug} →`}>
        <span class="mono">Next · Case {next.slug} →</span>
        <span class="t-d1 c-next-name">{next.title}</span>
        <span class="c-next-meta">{next.sector} · {next.country} · {next.year}</span>
      </a>
    </nav>
  </article>
</Base>
<style>
  @media (max-width: 599px) { .c-priv { border-radius: 12px; padding-block: .45rem; line-height: 1.5; } } /* wraps to 2 lines at 390: a 999px pill turned into a lozenge */
  .c-hero { padding-top: calc(var(--header-h) + 72px); display: grid; gap: 1.25rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: .25rem .75rem; }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: .75rem; color: var(--gray-500); }
  .crumbs a { color: var(--gray-300); display: inline-flex; min-height: 44px; align-items: center; }
  .crumbs a:hover { color: var(--lime); }
  .crumbs [aria-current] { color: var(--gray-400); display: inline-flex; min-height: 44px; align-items: center; }
  .c-strip { color: var(--lime); }
  .c-sub { color: var(--gray-400); max-width: 20ch; }
  .c-h1-wrap { display: grid; gap: .6rem; }
  .c-h1-k { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.15rem, 2vw, 1.6rem); line-height: 1.25; color: var(--gray-200); max-width: 36ch; letter-spacing: -.005em; }
  .c-sum { max-width: 62ch; color: var(--gray-300); }
  .c-faq, .c-rel { display: grid; gap: 1.5rem; }
  .c-faq > h2, .c-rel > h2 { font-weight: 400; }
  .c-rel-cases { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  .c-rel-cases a { display: grid; gap: .4rem; }
  .c-rel-cases :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border: 1px solid var(--gray-700); border-radius: 10px; transition: border-color .2s; }
  .c-rel-cases a:hover :global(img) { border-color: var(--lime); }
  .c-rel-cases .mono { color: var(--lime); font-size: 12px; letter-spacing: .1em; }
  .c-rel-cases b { font-family: var(--font-display); font-size: 1.35rem; }
  .c-rel-cases span:last-child { color: var(--gray-300); }
  .c-rel-links { display: flex; flex-wrap: wrap; gap: .5rem 2rem; }
  .c-rel-links a { display: inline-flex; min-height: 44px; align-items: center; }
  @media (max-width: 767px) { .c-rel-cases { grid-template-columns: 1fr; } }
  .c-actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .5rem; }
  .c-shot { margin-top: 72px; }
  .c-shot-frame { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--gray-700); }
  .c-shot-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: opacity .8s var(--ease-out); }
  :global(html.gl-live) .c-shot-frame:not(.is-resolved) :global(img) { opacity: 0; }
  :global(html.gl-live) .c-shot-frame:not(.is-resolved) { border-color: transparent; }
  .c-scan { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--lime); box-shadow: 0 0 14px var(--lime); opacity: 0; }
  :global(html.gl-live) .c-shot-frame.is-scanning .c-scan { animation: cscan 1.1s var(--ease-io) both; }
  @keyframes cscan { 0% { opacity: 1; top: 0; } 90% { opacity: 1; } 100% { opacity: 0; top: 100%; } }
  .c-result { display: grid; gap: 1.5rem; }
  .c-result-h { max-width: 24ch; color: var(--white); }
  .c-result-b { max-width: 60ch; }
  .c-metric { border: 1px dashed var(--gray-500); padding: .75rem 1rem; justify-self: start; }
  .c-facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--gutter); border-top: 1px solid var(--gray-700); padding-top: 1.5rem; margin-top: 2rem; }
  .c-facts dd { color: var(--gray-200); margin-top: .35rem; }
  .c-story { display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--gutter) * 3); padding-top: 0; }
  .c-story h2 { margin-bottom: 1.25rem; font-weight: 400; }
  .c-article { font-size: var(--fs-article); line-height: 1.7; max-width: 64ch; color: var(--gray-200); hanging-punctuation: first; }
  .c-plates { display: grid; gap: var(--gutter); align-items: start; }
  .c-plates--m { grid-template-columns: 1fr 300px; }
  .phone { border: 1px solid var(--gray-700); border-radius: 36px; padding: 10px; background: var(--gray-900); }
  .phone .browser-view { border-radius: 26px; height: min(70vh, 620px); }
  .c-cap { margin-top: 1rem; }
  .browser { border: 1px solid var(--gray-700); background: var(--gray-900); }
  .browser-bar { display: flex; align-items: center; gap: 6px; padding: 0 14px; height: 40px; border-bottom: 1px solid var(--gray-700); }
  .browser-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--gray-700); }
  .browser-bar .mono { margin-left: 12px; text-transform: none; letter-spacing: .04em; }
  .browser-view { height: min(70vh, 720px); overflow: hidden; }
  .browser-view :global(img) { width: 100%; height: auto; display: block; will-change: transform; }
  .c-out { display: grid; gap: 2rem; }
  .c-out > h2, .c-svcs h2 { font-weight: 400; }
  .c-svcs ul { display: flex; flex-wrap: wrap; gap: .5rem 2rem; margin-top: 1rem; }
  .c-svcs a { display: inline-flex; min-height: 44px; align-items: center; }
  .c-nodes { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); }
  .c-nodes li { display: grid; gap: .75rem; padding-top: 1.25rem; border-top: 1px solid var(--gray-700); position: relative; }
  .c-node { position: absolute; top: -6px; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 6px var(--lime-12); }
  .c-nodes p { color: var(--gray-200); }
  .c-cta { display: grid; gap: 1.5rem; justify-items: start; position: relative; padding-top: 200px; }
  .c-btns { display: flex; gap: .75rem; flex-wrap: wrap; }
  .node-anchor { position: absolute; left: 24px; top: 72px; }
  .c-next { border-top: 1px solid var(--gray-700); padding-block: 96px 160px; }
  .c-next-a { display: grid; gap: .75rem; }
  .c-next-name { color: var(--white); transition: color .2s; }
  .c-next-a:hover .c-next-name, .c-next-a:focus-visible .c-next-name { color: var(--lime); }
  .c-next-meta { color: var(--gray-400); }
  @media (max-width: 1023px) { .c-plates--m { grid-template-columns: 1fr; } .phone { max-width: 300px; } .c-facts { grid-template-columns: repeat(2, 1fr); row-gap: 1.25rem; } .c-story { grid-template-columns: 1fr; } .c-nodes { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 599px) { .c-nodes { grid-template-columns: 1fr; } .browser-view { height: 60vh; } }
</style>
