---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Page Not Found | Fazed Digital" description="The page you're looking for doesn't exist. Head back to the Fazed Digital homepage." formation="scatter" noindex>
  <section class="nf" data-f="scatter" aria-labelledby="nf-h">
    <div class="nf-radar" aria-hidden="true"></div>
    <div class="nf-water" aria-hidden="true">404</div>
    <div class="container nf-in">
      <p class="mono">Error 404 · Signal lost · <span class="nf-dots">Searching…</span></p>
      <h1 id="nf-h" class="t-d1">This page got lost in the ether.</h1>
      <p class="t-body-l">The page you wanted doesn’t exist, has moved, or never existed in the first place. The rest of the network is fine. Pick a way back.</p>
      <div class="nf-cta"><a class="btn btn--lime" href="/">Back to home <span class="arrow" aria-hidden="true">→</span></a><a class="btn btn--ghost" href="/work">See the work</a></div>
      <nav aria-label="Quick links"><ul class="nf-links mono"><li><a href="/services">Services</a></li><li><a href="/about">About</a></li><li><a href="/blog">Blog</a></li><li><a href="/contact">Contact</a></li><li><a href="/lp/7-day-website">7-day website</a></li></ul></nav>
      <p class="nf-help">Followed a broken link from our site? Tell us at <a class="link" href="mailto:info@fazeddigital.com">info@fazeddigital.com</a> and we’ll fix it.</p>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: clip; padding-top: var(--header-h); }
  .nf-radar { position: absolute; right: 8vw; top: 50%; width: min(44vw, 520px); aspect-ratio: 1; transform: translateY(-50%); border-radius: 50%; border: 1px solid var(--gray-700); background: conic-gradient(from 0deg, rgba(201,255,87,.2), transparent 25%); animation: sweep 3.5s linear infinite; }
  @keyframes sweep { to { transform: translateY(-50%) rotate(360deg); } }
  .nf-water { position: absolute; right: 4vw; bottom: 4vh; font-family: var(--font-display); font-weight: 700; font-size: clamp(8rem, 26vw, 24rem); line-height: .8; color: transparent; -webkit-text-stroke: 1px var(--gray-700); user-select: none; }
  .nf-in { position: relative; display: grid; gap: 1.5rem; justify-items: start; }
  .nf h1 { max-width: 13ch; }
  .nf-cta { display: flex; gap: .75rem; flex-wrap: wrap; }
  .nf-links { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }
  .nf-links a { display: inline-flex; min-height: 44px; align-items: center; color: var(--gray-300); }
  .nf-links a:hover { color: var(--lime); }
  .nf-help { color: var(--gray-400); }
  @media (max-width: 767px) { .nf-radar { width: 80vw; right: 10vw; top: 26%; opacity: .5; } }
</style>
