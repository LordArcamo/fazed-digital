---
import Base from '../../layouts/Base.astro';
import Lp from '../../components/Lp.astro';
import { lpFaq } from '../../data/lp';
import { SITE_URL } from '../../data/site';
import { crumbs, faqPage, ORG_REF } from '../../lib/schema';
const prices = ["499", "899", "1499"];
const names = ['Starter', 'Growth', 'Pro'];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: '7-Day Website Package', serviceType: 'Website design and development',
    provider: ORG_REF, areaServed: 'Worldwide', url: `${SITE_URL}/lp/7-day-website`,
    offers: prices.map((p, i) => ({ '@type': 'Offer', name: `${names[i]} Website Package`, price: p, priceCurrency: 'USD', availability: 'https://schema.org/InStock' })),
  },
  faqPage(lpFaq(false)),
  crumbs([['7-day website', '/lp/7-day-website']]),
];
---
<Base title="Professional Website in 7 Days, From $499 | Fazed Digital" description="A custom, mobile-ready, SEO-ready small business website, designed, built and launched in 7 days. Fixed price from $499. You own everything." image="/og/lp-7day.png" formation="days7" schema={schema} lp="usd">
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={`${SITE_URL}/lp/7-day-website`} />
    <link rel="alternate" hreflang="en-PH" href={`${SITE_URL}/lp/7-day-website/ph`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/lp/7-day-website`} />
  </Fragment>
  <Lp variant="usd" />
</Base>
