---
import Base from '../../../layouts/Base.astro';
import Lp from '../../../components/Lp.astro';
import { lpFaq } from '../../../data/lp';
import { SITE_URL } from '../../../data/site';
import { crumbs, faqPage, ORG_REF } from '../../../lib/schema';
const prices = ["19999", "34999", "59999"];
const names = ['Starter', 'Growth', 'Pro'];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: '7-Day Website Package', serviceType: 'Website design and development',
    provider: ORG_REF, areaServed: 'Philippines', url: `${SITE_URL}/lp/7-day-website/ph`,
    offers: prices.map((p, i) => ({ '@type': 'Offer', name: `${names[i]} Website Package`, price: p, priceCurrency: 'PHP', availability: 'https://schema.org/InStock' })),
  },
  faqPage(lpFaq(true)),
  crumbs([['7-day website', '/lp/7-day-website'], ['Philippine pricing', '/lp/7-day-website/ph']]),
];
---
<Base title="Website in 7 Days, From ₱19,999 | Fazed Digital Philippines" description="Custom website for your Philippine business, live in 7 days. From ₱19,999, fixed price. Pay via GCash, Maya or bank. Built in Iligan City, Mindanao." image="/og/lp-7day-ph.png" formation="days7" schema={schema} lp="php">
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={`${SITE_URL}/lp/7-day-website`} />
    <link rel="alternate" hreflang="en-PH" href={`${SITE_URL}/lp/7-day-website/ph`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/lp/7-day-website`} />
  </Fragment>
  <Lp variant="php" />
</Base>
