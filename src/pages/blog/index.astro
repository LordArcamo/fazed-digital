    '@type': 'BlogPosting', headline: p.title, description: p.excerpt, url: `${SITE_URL}/blog/${p.slug}`,
    datePublished: new Date(p.date).toISOString(), dateModified: new Date(p.date).toISOString(),
    author: { '@type': 'Person', name: p.author, url: `${SITE_URL}/about#${authorId(p.author)}` },
    image: `${SITE_URL}/og/blog/${p.slug}.png`, articleSection: p.category, keywords: p.category,
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}/blog/${p.slug}` },
  })),
};
---
<Base
  title="Blog — Web Design, SEO & Branding Insights | Fazed Digital"
  description="Practical, no-fluff guides on web design, SEO, branding and strategy for small business owners, from the Fazed Digital team in Iligan City, Philippines."
  image="/og/blog.png"
  formation="lattice"
  schema={[blogSchema, crumbs([['Blog', '/blog']])]}
  current="/blog"
>
  <BlogList posts={sorted} featured={featured} rest={rest} cats={cats} latest={latest} />
</Base>
