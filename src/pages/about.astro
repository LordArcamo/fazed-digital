---
import Base from '../layouts/Base.astro';
import { team } from '../data/team';
import { stats } from '../data/proof';
import { NAP, SITE_URL, YEARS } from '../data/site';
import { crumbs, ORG_REF } from '../lib/schema';
const timeline = [
  ['2022', 'Fazed Digital founded in Iligan City'],
  ['2024', 'Ships for clients in the USA and Australia: A Framing Company, CrateOnScene, The Telecom Shop, Canwell, UGLQ, 8Drive'],
  ['2025', 'Brand + web for Cleen & Green. A full website, portal and app suite for QLD Law Group'],
  ['2026', 'Launches the 7-day website package and a practical blog for small business owners'],
];
const values = [
  ['01', 'Bold by default', 'Safe design is invisible design. Every colour, word and decision is made with conviction, and we’ll explain the reason behind each one.'],
  ['02', 'Strategy first', 'Beautiful design without a purpose is decoration. We ask why before we touch a pixel.'],
  ['03', 'Craft matters', 'Type, spacing, motion, load time. Every detail earns its place, including the ones you’ll only feel.'],
  ['04', 'You win, we win', 'We measure success by your growth, not by our awards cabinet.'],
];
const promises = [
  ['You own everything.', 'Domain, hosting, logins, design files and content, all in your name.'],
  ['Scope before price.', 'You get an itemised quote, so you know exactly what you’re paying for.'],
  ['One team, direct line.', 'No anonymous hand-offs.'],
  ['A reply within one business day.', 'Mon–Fri, 8:30am–5:00pm Philippine time.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'AboutPage', url: `${SITE_URL}/about`, name: 'About Fazed Digital', about: ORG_REF },
  ...team.map((p) => ({ '@context': 'https://schema.org', '@type': 'Person', name: p.name, jobTitle: p.role, worksFor: ORG_REF, url: `${SITE_URL}/about#${p.id}`, '@id': `${SITE_URL}/about#${p.id}` })),
  crumbs([['About', '/about']]),
];
---
<Base title="About Fazed Digital | Web Design Agency in Iligan City" description="Meet Fazed Digital: a web design, branding and SEO studio founded in Iligan City, Philippines in 2022, building for clients in the USA, Australia and PH." formation="rings" schema={schema} current="/about">
  <section class="a-hero" data-f="rings" data-rs="1.75" aria-labelledby="a-h">
    <div class="a-rings-anchor" data-rings-anchor aria-hidden="true"></div>
    <svg class="poster-art a-poster" viewBox="0 0 200 200" aria-hidden="true"><g fill="none" stroke="#F5F4F0" stroke-opacity=".35" stroke-dasharray="1 3"><ellipse cx="100" cy="100" rx="36" ry="17" /><ellipse cx="100" cy="100" rx="56" ry="26" /><ellipse cx="100" cy="100" rx="80" ry="38" /></g><circle cx="100" cy="100" r="3" fill="#C9FF57" /><circle cx="160" cy="125" r="3" fill="#F5F4F0" /><circle cx="60" cy="80" r="3" fill="#F5F4F0" /><circle cx="130" cy="78" r="3" fill="#F5F4F0" /><circle cx="44" cy="118" r="3" fill="#F5F4F0" /></svg>
    <div class="container a-hero-in">
      <p class="mono">About · Iligan City, Lanao del Norte · Est. 2022</p>
      <h1 id="a-h" class="t-d1"><span class="h-l1">Small studio.</span> <span class="h-l2">Serious reach.</span></h1>
      <p class="t-body-l a-deck">Fazed Digital started in Iligan City in 2022 with one belief: small and mid-sized businesses deserve agency-level design and strategy, without the agency-sized price tag or attitude.</p>
      <a class="btn btn--ghost" href="/work">See the work</a>
    </div>
  </section>

  <section class="section container a-story" data-f="lattice" aria-labelledby="st-h">
    <div><p class="mono">Our story · 2022 → now</p><h2 id="st-h" class="t-d2">Started small. Think big.</h2></div>
    <div class="a-story-b">
      <p class="t-body-l">We started as a one-person studio in Iligan City. {YEARS === 1 ? 'A year' : `${['Zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten'][YEARS] ?? YEARS} years`} later we’re a tight-knit team of designers, strategists and developers, and our work runs businesses in Utah, Queensland and here at home.</p>
      <p>We grew by doing the unglamorous things properly: asking the right questions first, quoting the real scope, putting your domain in your name, and answering when you message.</p>
      <p>Every project still starts the same way. Who are you? Who are you talking to? What do you want them to feel? The answers shape everything that follows.</p>
      <ol class="rail">{timeline.map(([y, t]) => <li class="rv"><span class="mono rail-y">{y}</span><span class="rail-dot" aria-hidden="true"></span><p>{t}</p></li>)}</ol>
    </div>
  </section>

  <section class="section container a-where" aria-labelledby="wh-h">
    <p class="mono">{NAP.coords}</p>
    <h2 id="wh-h" class="t-d2">Rooted in Mindanao. <span class="dim">Working everywhere.</span></h2>
    <div class="a-cols">
      <p>Iligan City is home. It’s where we hire, think and build. Our clients are wherever their customers are: contractors in Utah, retailers and law firms in Australia, and service businesses across the Philippines.</p>
      <p>Working remotely isn’t a compromise for us; it’s how we’ve always worked. You get clear milestones, regular video check-ins and detailed written updates, so you always know where your project stands.</p>
    </div>
  </section>

  <section class="section a-team" id="team" data-f="rings" aria-labelledby="tm-h">
    <div class="container">
      <p class="mono">The team · 04</p>
      <h2 id="tm-h" class="t-d2">The people behind the work.</h2>
      <p class="a-team-intro">The people you meet on the first call are the people who do the work.</p>
      <ul class="a-ppl" data-rings-anchor>
        {team.map((p, i) => (
          <li class="person rv" id={p.id} tabindex="0" data-person={i}>
            {p.photo ? <img class="person-img" src={p.photo} alt={`Portrait of ${p.name}, ${p.role} at Fazed Digital`} width="120" height="120" loading="lazy" decoding="async" /> : <span class="person-init mono" aria-hidden="true">{p.initials}</span>}
            <h3 class="person-n">{p.name}</h3><p class="mono">{p.role}</p><p class="person-b">{p.bio}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- lab-spec §8: "The engine" teaser → /lab#engine (no data-f: the team rings keep playing through it, as before) -->
  <section class="section container a-engine" aria-labelledby="ae-h">
    <p class="mono">The engine · 04 people + 1 crew</p>
    <h2 id="ae-h" class="t-h3 a-engine-h">We wrote our own AI production crew. <span class="dim">People still make every call that matters.</span></h2>
    <a class="link a-engine-a" href="/lab#engine">See how the engine works <span aria-hidden="true">→</span></a>
  </section>

  <section class="section container a-stats" aria-label="Studio numbers">
    <dl class="stats">{stats.filter((s) => s.show).map((s) => <div class="stat"><dt class="mono">{s.label}</dt><dd><span class="stat-v">{s.value}{s.suffix}</span><span class="mono">{s.sub}</span></dd></div>)}</dl>
  </section>

  <section class="section container a-values" aria-labelledby="v-h">
    <div><p class="mono">Our values · 04</p><h2 id="v-h" class="t-d2">What drives every decision.</h2></div>
    <ol>{values.map(([n, t, b]) => <li class="rv"><span class="mono">{n}</span><h3 class="t-h3">{t}</h3><p>{b}</p></li>)}</ol>
  </section>

  <section class="section container a-prom" aria-labelledby="p-h">
    <h2 id="p-h" class="t-d2">Four promises, in writing.</h2>
    <ul>{promises.map(([t, b]) => <li class="rv"><span class="tick" aria-hidden="true"></span><p><strong>{t}</strong> {b}</p></li>)}</ul>
  </section>

  <section class="section container a-cta" data-f="node" aria-labelledby="c-h">
    <span class="node-anchor" data-node-anchor aria-hidden="true"></span>
    <h2 id="c-h" class="t-d1">Ready to start <span class="dim">something?</span></h2>
    <p class="t-body-l">Tell us what you’re building. We’ll come back with questions, not a pitch deck.</p>
    <div class="a-btns"><a class="btn btn--lime" href="/contact" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a><a class="btn btn--ghost" href="/blog">Read our guides</a></div>
  </section>
</Base>
<script>
  function initPeople() {
    document.querySelectorAll<HTMLElement>('[data-rings-anchor]').forEach((ppl) => {
      if (ppl.dataset.bound || !ppl.querySelector('[data-person]')) return;
      ppl.dataset.bound = '1';
      const emit = (i: number) => document.dispatchEvent(new CustomEvent('fz:person', { detail: i }));
      const on = (e: Event) => { const p = (e.target as HTMLElement).closest<HTMLElement>('[data-person]'); ppl.querySelectorAll('.person').forEach((x) => x.classList.toggle('is-on', x === p)); emit(p ? +p.dataset.person! : -1); };
      ppl.addEventListener('pointerover', on); ppl.addEventListener('focusin', on);
      ppl.addEventListener('pointerleave', () => emit(-1)); ppl.addEventListener('focusout', () => emit(-1));
    });
  }
  document.addEventListener('astro:page-load', initPeople);
  initPeople();
</script>
<style>
  /* hero: 140vh rings, centred near the right edge and cropped by it */
  .a-hero { position: relative; min-height: 100svh; display: flex; align-items: center; padding-top: var(--header-h); overflow: hidden; }
  .a-rings-anchor { position: absolute; left: 88vw; top: 58%; width: 8vw; height: 20vh; transform: translate(-50%, -50%); }
  .a-poster { position: absolute; left: calc(88vw - 87.5vh); top: 58%; width: 175vh; max-width: none; transform: translateY(-50%); }
  .a-hero-in { display: grid; gap: 1.5rem; justify-items: start; }
  .a-hero h1 { max-width: none; }
  /* two-line rhythm like home: line 2 in gray-400 */
  .a-hero h1 .h-l1, .a-hero h1 .h-l2 { display: block; } .a-hero h1 .h-l2 { color: var(--gray-400); }
  .a-deck { max-width: 44ch; }
  .a-story, .a-values { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 2rem; }
  .a-story > div:first-child, .a-values > div { grid-column: 1 / span 5; display: grid; gap: 1rem; align-content: start; }
  .a-story-b { grid-column: 7 / span 6; display: grid; gap: 1.25rem; }
  .rail { display: grid; gap: 1.5rem; margin-top: 2rem; border-left: 1px solid var(--gray-700); padding-left: 1.5rem; }
  .rail li { position: relative; display: grid; gap: .3rem; }
  .rail-y { color: var(--lime); }
  .rail-dot { position: absolute; left: calc(-1.5rem - 5px); top: .35rem; width: 9px; height: 9px; border-radius: 50%; background: var(--lime); }
  .a-where { display: grid; gap: 1.5rem; }
  .a-cols { display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--gutter) * 2); max-width: 1100px; }
  .a-team-intro { margin: 1rem 0 3rem; max-width: 50ch; }
  .a-ppl { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); }
  .person { display: grid; gap: .5rem; align-content: start; padding: 1.5rem; border: 1px solid var(--gray-700); background: rgba(9, 9, 9, .75); transition: border-color .2s; }
  .person:hover, .person:focus-visible, .person.is-on { border-color: var(--lime); }
  .person-img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; object-position: top; filter: grayscale(1); margin-bottom: .5rem; }
  .person:hover .person-img, .person:focus-visible .person-img { filter: none; }
  .person-init { width: 96px; height: 96px; border-radius: 50%; border: 1.5px solid var(--lime); display: flex; align-items: center; justify-content: center; color: var(--lime); margin-bottom: .5rem; }
  .person-n { font-size: 1.2rem; }
  .person-b { font-size: .95rem; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); border-top: 1px solid var(--gray-700); }
  .stat { padding-top: 1.5rem; display: grid; gap: .5rem; }
  .stat dd { display: grid; gap: .5rem; }
  .stat-v { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-d2); color: var(--white); line-height: 1; }
  .a-values ol { grid-column: 7 / span 6; display: grid; }
  .a-values li { display: grid; grid-template-columns: 3rem 1fr; column-gap: 1rem; row-gap: .4rem; padding: 1.5rem 0; border-top: 1px solid var(--gray-700); }
  .a-values li .mono { grid-row: span 2; color: var(--lime); }
  .a-prom { display: grid; gap: 2rem; }
  .a-prom ul { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem var(--gutter); }
  .a-prom li { display: grid; grid-template-columns: 24px 1fr; gap: 1rem; }
  .a-prom strong { color: var(--white); }
  .tick { width: 12px; height: 12px; margin-top: .45rem; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 5px var(--lime-12); }
  .a-stats, .a-values, .a-prom, .a-cta, .a-team, .a-where { --section: clamp(96px, 12vh, 160px); }
  .a-engine { --section: clamp(72px, 9vh, 120px); padding-bottom: 0; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 1rem; align-items: end; }
  .a-engine > .mono { grid-column: 1 / -1; }
  .a-engine-h { grid-column: 1 / span 8; font-size: clamp(1.5rem, 2.6vw, 2.25rem); line-height: 1.12; max-width: 30ch; }
  .a-engine-a { grid-column: 10 / span 3; justify-self: end; display: inline-flex; align-items: center; gap: .4em; min-height: 44px; font-weight: 600; white-space: nowrap; }
  @media (max-width: 1023px) { .a-engine-h, .a-engine-a { grid-column: 1 / -1; justify-self: start; } }
  .a-cta { display: grid; gap: 1.5rem; justify-items: start; position: relative; padding-top: clamp(160px, 20vh, 200px); }
  .a-btns { display: flex; gap: .75rem; flex-wrap: wrap; }
  .node-anchor { position: absolute; left: 24px; top: 80px; }
  @media (max-width: 1023px) {
    .a-story > *, .a-values > *, .a-values ol { grid-column: 1 / -1 !important; }
    .a-ppl { grid-template-columns: 1fr 1fr; }
    .stats { grid-template-columns: 1fr 1fr; row-gap: 2rem; }
    .a-poster, .a-rings-anchor { width: 80vw; left: auto; right: 10vw; top: 28%; opacity: .7; transform: translateY(-50%); }
    .a-hero { align-items: flex-end; padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 599px) { .a-ppl, .a-cols, .a-prom ul { grid-template-columns: 1fr; } }
</style>
