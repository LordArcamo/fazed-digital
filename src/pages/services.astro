---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import Faq from '../components/Faq.astro';
import { chapters, serviceFaq } from '../data/services';
import { capsCopy } from '../data/proof';
import { SITE_URL } from '../data/site';
import { crumbs, faqPage, ORG_REF } from '../lib/schema';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Fazed Digital services',
    itemListElement: chapters.map((c, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Service', name: c.h2, description: c.outcome, url: `${SITE_URL}/services#${c.id}`, provider: ORG_REF, areaServed: 'Worldwide' } })),
  },
  faqPage(serviceFaq),
  crumbs([['Services', '/services']]),
];
---
<Base
  title="Web Design, Branding & SEO Services | Fazed Digital PH"
  description="Web design, branding, SEO, product design and custom web apps from Iligan City, Philippines, for clients worldwide. Clear scope, real proof."
  formation="pentagon"
  schema={schema}
  current="/services"
>
  <section class="s-hero" data-f="pentagon" data-fx="0.5" data-fy="0.54" data-fr="0.27" data-fdim="0.35" aria-labelledby="s-h">
    <svg class="poster-art s-poster" viewBox="0 0 200 200" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((k) => { const a = (-90 + k * 72) * Math.PI / 180, b = (-90 + ((k + 1) % 5) * 72) * Math.PI / 180; return <g><line x1={100 + Math.cos(a) * 80} y1={100 + Math.sin(a) * 80} x2={100 + Math.cos(b) * 80} y2={100 + Math.sin(b) * 80} stroke="#F5F4F0" stroke-opacity=".3" stroke-width=".5" /><line x1="100" y1="100" x2={100 + Math.cos(a) * 80} y2={100 + Math.sin(a) * 80} stroke="#F5F4F0" stroke-opacity=".16" stroke-width=".5" /><circle cx={100 + Math.cos(a) * 80} cy={100 + Math.sin(a) * 80} r="1.6" fill="#F5F4F0" fill-opacity=".6" /></g>; })}
      <circle cx="100" cy="100" r="5" fill="none" stroke="#C9FF57" stroke-opacity=".35" stroke-width=".4" />
      <circle cx="100" cy="100" r="1.8" fill="#C9FF57" />
    </svg>
    <div class="container s-hero-in">
      <p class="mono">What we do · 05 services · 01 system</p>
      <h1 id="s-h" class="t-d1">Services that move the needle.</h1>
      <p class="t-body-l s-deck">Brand, website, search, product and systems, built by one team so they actually fit together. Hire us for one piece, or let us connect the lot.</p>
      <div class="s-cta">
        <a class="btn btn--lime" href="/contact" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/lp/7-day-website">Get live in 7 days</a>
      </div>
    </div>
    <!-- the pentagon's vertices are the jump links (≥1024 they sit on the field's nodes) -->
    <nav class="s-jump" aria-label="Jump to a service">
      <ul>{chapters.map((c, k) => <li class={`v${k}`}><a href={`#${c.id}`}><span class="mono">{c.n}</span> <span class="s-jl">{c.id === 'web' ? 'Web' : c.id === 'brand' ? 'Brand' : c.id === 'seo' ? 'SEO' : c.id === 'product' ? 'Product' : 'Systems'}</span><span class="sr-only">: {c.h2}</span></a></li>)}</ul>
    </nav>
  </section>
  {chapters.map((c, i) => (
    <section class="chap" id={c.id} data-f="pentagon" data-step={i} data-fx="0.2" data-fy="0.5" data-fr="0.11" aria-labelledby={`${c.id}-h`}>
      <div class="container chap-in">
        <div class="chap-side">
          <p class="mono chap-n">Node {c.n}/05 · {c.id}</p>
          <div class="chap-glyph"><Glyph id={c.id} size={120} /></div>
        </div>
        <div class="chap-main">
          <h2 id={`${c.id}-h`} class="t-h3 chap-h2">{c.h2}</h2>
          <p class="t-d2 chap-out">{c.outcome}</p>
          <div class="chap-body">{c.body.map((p) => <p>{p}</p>)}</div>
          <div class="chap-cols">
            <div><h3 class="mono">What you get</h3><ul class="ticks">{c.get.map((g) => <li>{g}</li>)}</ul></div>
            <div><h3 class="mono">Good fit if</h3><ul class="ticks ticks--dim">{c.fit.map((g) => <li>{g}</li>)}</ul></div>
          </div>
          <div class="chap-proof">
            <h3 class="mono">Proof</h3>
            <ul>{c.proof.map((p) => <li><p class="mono">{p.tag}</p><p>{p.text}</p><a class="link" href={p.link.href}>{p.link.label}</a></li>)}</ul>
          </div>
          {c.timeline && <p class="chap-time"><span class="mono">Timeline</span> {c.timeline} {c.id === 'web' && <a class="link" href="/lp/7-day-website">Get live in 7 days</a>}</p>}
          <p class="chap-read"><span class="mono">Related reading</span> {c.reading.map((r, k) => <>{k ? ' · ' : ''}<a class="link" href={r.href}>{r.label}</a></>)}</p>
          <a class="btn btn--lime chap-cta" href={c.cta.href}>{c.cta.label} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  ))}

  <section class="section s-faq" id="faq" data-f="lattice" aria-labelledby="faq-h">
    <div class="container s-faq-in">
      <div><p class="mono">FAQ · {String(serviceFaq.length).padStart(2, '0')}</p><h2 id="faq-h" class="t-d2">Questions about working with us</h2></div>
      <Faq items={serviceFaq} id="sfaq" />
    </div>
  </section>

  <section class="section s-end" id="next" data-f="node" aria-labelledby="end-h">
    <div class="container s-end-in">
      <span class="node-anchor" data-node-anchor aria-hidden="true"></span>
      <span class="s-ring poster-art" aria-hidden="true"></span>
      <p class="mono">Ready when you are</p>
      <h2 id="end-h" class="t-d1">Pick a node. <span class="dim">We’ll connect the rest.</span></h2>
      <p class="t-body-l">Send a short brief. We’ll reply within one business day with questions, a rough scope and next steps.</p>
      <p class="mono s-cap">{capsCopy.custom}</p>
      <div class="s-cta">
        <a class="btn btn--lime" href="/contact" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <p>Need it fast? <a class="link" href="/lp/7-day-website">Get live in 7 days</a> · <a class="link" href="/lp/7-day-website/ph">See peso pricing (₱)</a></p>
    </div>
  </section>
</Base>
<style>
  /* hero: the pentagon is full-bleed behind the H1 at 35%, the H1 centred on its middle node */
  .s-hero { --R: min(27vw, 47.25vh); --cy: 54vh; position: relative; min-height: 100svh; display: flex; align-items: center; justify-content: center; padding-top: var(--header-h); text-align: center; overflow: hidden; }
  .s-poster { position: absolute; width: calc(var(--R) * 2.5); left: 50%; top: var(--cy); transform: translate(-50%, -50%); }
  .s-hero-in { position: relative; display: grid; gap: 1.5rem; justify-items: center; }
  .s-hero h1 { max-width: 13ch; }
  .s-deck { max-width: 44ch; }
  .s-cta { display: flex; gap: .75rem; flex-wrap: wrap; justify-content: center; }
  .s-jump a { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; color: var(--gray-300); font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .s-jump a .mono { color: var(--gray-400); }
  .s-jump a:hover, .s-jump a:focus-visible, .s-jump a:hover .mono { color: var(--lime); }
  @media (min-width: 1024px) {
    .s-jump li { position: absolute; left: calc(50% + var(--x) * var(--R)); top: calc(var(--cy) + var(--y) * var(--R)); translate: var(--tx) var(--ty); white-space: nowrap; }
    .s-jump a { padding: 0 6px; }
    .v0 { --x: 0; --y: -1; --tx: -50%; --ty: calc(-100% - 6px); }
    .v1 { --x: .951; --y: -.309; --tx: 14px; --ty: -50%; }
    .v2 { --x: .588; --y: .809; --tx: 14px; --ty: -50%; }
    .v3 { --x: -.588; --y: .809; --tx: calc(-100% - 14px); --ty: -50%; }
    .v4 { --x: -.951; --y: -.309; --tx: calc(-100% - 14px); --ty: -50%; }
  }
  @media (max-width: 1023px) {
    .s-hero { --R: 27vw; }
    .s-hero { flex-direction: column; padding-bottom: 112px; }
    .s-jump { margin-top: 1.5rem; }
    .s-jump ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1rem; padding: 0 var(--side); }
  }
  .chap { padding-block: clamp(96px, 12vh, 160px) 0; }
  .chap-in { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); }
  .chap-side { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 48px); align-self: start; display: grid; gap: 2rem; min-height: 40vh; }
  .chap-n { color: var(--lime); }
  :global(html.gl-live) .chap-glyph { visibility: hidden; }
  .chap-main { grid-column: 6 / span 7; display: grid; gap: 2rem; padding-bottom: var(--section); border-bottom: 1px solid var(--gray-700); }
  .chap-h2 { color: var(--gray-300); }
  .chap-out { color: var(--white); }
  .chap-body { display: grid; gap: 1rem; max-width: 62ch; }
  .chap-cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .chap-cols h3, .chap-proof h3 { margin-bottom: 1rem; font-weight: 400; }
  .ticks { display: grid; gap: .6rem; }
  .ticks li { padding-left: 1.4rem; position: relative; color: var(--gray-200); }
  .ticks li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--lime); }
  .ticks--dim li::before { background: transparent; border: 1px solid var(--gray-400); }
  .chap-proof ul { display: grid; gap: 1.25rem; }
  .chap-proof li { display: grid; gap: .3rem; padding-left: 1rem; border-left: 1px solid var(--gray-700); }
  .chap-proof .link { justify-self: start; }
  .chap-time, .chap-read { color: var(--gray-300); }
  .chap-time .mono, .chap-read .mono { margin-right: .75rem; }
  .chap-cta { justify-self: start; }
  .s-faq-in { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 2rem; }
  .s-faq-in > div:first-child { grid-column: 1 / span 4; display: grid; gap: 1rem; align-content: start; }
  .s-faq-in > :global(.faq) { grid-column: 6 / span 7; }
  .s-end { text-align: center; }
  .s-end-in { display: grid; gap: 1.5rem; justify-items: center; position: relative; padding-top: 160px; }
  .s-end h2 { max-width: 14ch; }
  .s-cap { color: var(--lime); }
  .node-anchor { position: absolute; left: 50%; top: 40px; width: 1px; height: 1px; }
  .s-ring { position: absolute; left: 50%; top: 40px; width: 230px; height: 230px; margin: -115px; border-radius: 50%; background: radial-gradient(circle, var(--lime) 0 8px, transparent 8.5px 31px, var(--lime-25) 31.5px 32.5px, transparent 33px 71px, var(--lime-12) 71.5px 72.5px, transparent 73px 111px, rgba(201,255,87,.08) 111.5px 112.5px, transparent 113px); }
  @media (max-width: 1023px) {
    .s-poster { left: 50%; top: 24%; width: 60vw; opacity: .6; }
    .s-hero { align-items: flex-end; padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
    .chap-in > * { grid-column: 1 / -1 !important; }
    .chap-side { position: static; min-height: 0; grid-template-columns: auto 1fr; align-items: center; margin-bottom: 1.5rem; }
    .chap-glyph :global(svg) { width: 56px; height: 56px; }
    :global(html.gl-live) .chap-glyph { visibility: visible; }
    .chap-cols { grid-template-columns: 1fr; }
    .s-faq-in > * { grid-column: 1 / -1 !important; }
  }
</style>
