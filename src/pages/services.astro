---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import Faq from '../components/Faq.astro';
import { chapters, serviceFaq } from '../data/services';
import { capsCopy, prices } from '../data/proof';
import { SITE_URL } from '../data/site';
import { crumbs, faqPage, ORG_REF } from '../lib/schema';
import { SERVICE_NAV, SERVICE_TOTAL, serviceHref, servicePath } from '../data/service-nav';
import { servicePages } from '../data/service-pages';
import posts from '../data/.generated/posts.json';

// Seven services (copy/service-pages/hub.md, 10 Nov 2026). H1 approved by the owner (relayed by the coordinator).
// Each chapter is a summary that hands off to its own page; the chapter ids stay (blog posts link to them).
const N = SERVICE_TOTAL;
const pad2 = (n: number) => String(n).padStart(2, '0');
const navOf = (id: string) => SERVICE_NAV.find((s) => s.id === id)!;
const handoff: Record<string, string> = {
  web: 'Web design and development in detail', brand: 'Brand identity: process and deliverables', seo: 'How our SEO and AI search service works',
  product: 'UI/UX and product design in detail', systems: 'Custom web apps, booking systems and portals', automations: 'Automations: tools, packages and prices', social: 'Social media plans and what’s in them',
};
// one proof line per chapter; SEO uses our own site (no client SEO result is claimed), with the live guide count
const proofOf = (c: (typeof chapters)[number]) => c.id === 'seo'
  ? { tag: 'Our own site', text: `${posts.length} practical guides on our blog, plus structured data on every page of this site. We practise what we sell.`, link: { label: 'Read the SEO guides', href: '/blog/category/seo' } }
  : c.proof[0];
const jumpLabel: Record<string, string> = { web: 'Web', brand: 'Brand', seo: 'SEO', product: 'UI/UX', systems: 'Web apps', automations: 'Automations', social: 'Social' };
// a question marked up on a service page leaves the hub's FAQPage (one marked-up instance per question sitewide)
const owned = new Set(Object.values(servicePages).flatMap((p) => p.faq.map((f) => f.q)));
const hubFaqMarkup = serviceFaq.filter((f) => !owned.has(f.q));
const vert = (k: number) => { const a = (-90 + (k * 360) / N) * Math.PI / 180; return { x: Math.cos(a), y: Math.sin(a) }; };

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Fazed Digital services',
    itemListElement: chapters.map((c, i) => {
      const url = `${SITE_URL}${serviceHref(c.id)}`, live = navOf(c.id).live;
      // a live service is defined once, on its own page: the hub only references it
      return { '@type': 'ListItem', position: i + 1, item: live ? { '@id': `${url}#service`, name: c.h2, url } : { '@type': 'Service', name: c.h2, description: c.outcome, url, provider: ORG_REF, areaServed: 'Worldwide' } };
    }),
  },
  faqPage(hubFaqMarkup),
  crumbs([['Services', '/services']]),
];
---
<Base
  title="Web Design, Branding, SEO, Apps & Automation | Fazed"
  image="/og/services.png"
  description={`Websites, brand identity, SEO, UI/UX, web apps, automations and social media from one studio in the Philippines. 7-day sites from ${prices.usd.starter}.`}
  formation="pentagon"
  schema={schema}
  current="/services"
>
  <section class="s-hero" data-f="pentagon" data-fsides={N} data-fx="0.5" data-fy="0.54" data-fr="0.27" data-fdim="0.35" data-ftop="128" aria-labelledby="s-h">
    <svg class="poster-art s-poster" viewBox="0 0 200 200" aria-hidden="true">
      {Array.from({ length: N }, (_, k) => { const a = vert(k), b = vert((k + 1) % N); return <g><line x1={100 + a.x * 80} y1={100 + a.y * 80} x2={100 + b.x * 80} y2={100 + b.y * 80} stroke="#F5F4F0" stroke-opacity=".3" stroke-width=".5" /><line x1="100" y1="100" x2={100 + a.x * 80} y2={100 + a.y * 80} stroke="#F5F4F0" stroke-opacity=".16" stroke-width=".5" /><circle cx={100 + a.x * 80} cy={100 + a.y * 80} r="1.6" fill="#F5F4F0" fill-opacity=".6" /></g>; })}
      <circle cx="100" cy="100" r="5" fill="none" stroke="#C9FF57" stroke-opacity=".35" stroke-width=".4" />
      <circle cx="100" cy="100" r="1.8" fill="#C9FF57" />
    </svg>
    <div class="container s-hero-in">
      <p class="mono">What we do · {pad2(N)} services · 01 system</p>
      <h1 id="s-h" class="t-d1"><span class="h-l1">Seven services.</span> <span class="h-l2">One connected brand.</span></h1>
      <p class="t-body-l s-deck">Fazed Digital is one team in Iligan City, Philippines, with seven services that fit together: web design, brand identity, SEO and AI search, UI/UX design, custom web apps, automations and social media management. Fixed-price websites start at {prices.usd.starter} ({prices.php.starter}) and go live in 7 business days. Custom builds take 4–12+ weeks and typically run {prices.customRange}. Hire us for one piece, or connect the lot.</p>
      <div class="s-cta">
        <a class="btn btn--lime" href="/contact" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/lp/7-day-website">Get live in 7 days</a>
      </div>
    </div>
    <!-- the heptagon's vertices are the jump links (≥1024 they sit on the field's nodes) -->
    <nav class="s-jump" aria-label="Jump to a service">
      <ul>{chapters.map((c, k) => { const p = vert(k); return <li style={`--x:${p.x.toFixed(4)};--y:${p.y.toFixed(4)}`} class:list={[`v${k}`, p.x > 0.05 ? 'is-r' : p.x < -0.05 ? 'is-l' : 'is-t']}><a href={`#${c.id}`}><span class="mono">{c.n}</span> <span class="s-jl">{jumpLabel[c.id]}</span><span class="sr-only">: {c.h2}</span></a></li>; })}</ul>
    </nav>
  </section>
  {chapters.map((c, i) => {
    const pr = proofOf(c), nav = navOf(c.id);
    return (
    <section class="chap" id={c.id} data-f="pentagon" data-fsides={N} data-step={i} data-fx="0.2" data-fy="0.5" data-fr="0.11" aria-labelledby={`${c.id}-h`}>
      <div class="container chap-in">
        <div class="chap-side">
          <p class="mono chap-n">Node {c.n}/{pad2(N)} · {c.id}</p>
          <div class="chap-glyph"><Glyph id={c.id} size={120} /></div>
        </div>
        <div class="chap-main">
          <h2 id={`${c.id}-h`} class="t-h3 chap-h2">{c.h2}</h2>
          <p class="t-d2 chap-out">{c.outcome}</p>
          <div class="chap-body"><p>{c.body[0]}</p>{c.id === 'systems' && <p>Need one workflow, not a whole system? <a class="link" href={serviceHref('automations')}>See automations</a>.</p>}</div>
          <div class="chap-cols">
            <div><h3 class="mono">What you get</h3><ul class="ticks">{c.get.slice(0, 4).map((g) => <li>{g}</li>)}</ul></div>
            <div class="chap-proof"><h3 class="mono">Proof</h3><ul><li><p class="mono">{pr.tag}</p><p>{pr.text}</p><a class="link" href={pr.link.href}>{pr.link.label}</a></li></ul></div>
          </div>
          {(c.id === 'automations' || c.id === 'social') && c.timeline && <p class="chap-time"><span class="mono">{c.id === 'social' ? 'Plans' : 'Price'}</span> {c.timeline}</p>}
          {nav.live && <a class="chap-hand" href={servicePath(nav)}><span class="mono">{nav.n.replace('04.', '0')} · Full page</span><span class="chap-hand-l">{handoff[c.id]}</span><span class="arrow" aria-hidden="true">→</span></a>}
          <a class="btn btn--lime chap-cta" href={c.cta.href}>{c.cta.label} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  ); })}

  <section class="section s-faq" id="faq" data-f="lattice" aria-labelledby="faq-h">
    <div class="container s-faq-in">
      <div><p class="mono">FAQ · {String(serviceFaq.length).padStart(2, '0')}</p><h2 id="faq-h" class="t-d2">Questions about working with us</h2></div>
      <Faq items={serviceFaq} id="sfaq" />
    </div>
  </section>

  <section class="section s-end" id="next" data-f="node" aria-labelledby="end-h">
    <div class="container s-end-in">
      <span class="node-anchor" data-node-anchor aria-hidden="true"></span>
      <span class="s-ring poster-art" aria-hidden="true"></span>
      <p class="mono">Ready when you are</p>
      <h2 id="end-h" class="t-d1">Pick a node. <span class="dim">We’ll connect the rest.</span></h2>
      <p class="t-body-l">Send a short brief. We’ll reply within one business day with questions, a rough scope and next steps.</p>
      <p class="mono s-cap">{capsCopy.custom}</p>
      <div class="s-cta">
        <a class="btn btn--lime" href="/contact" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <p>Need it fast? <a class="link" href="/lp/7-day-website">Get live in 7 days</a><span data-market="ph"> · <a class="link" href="/lp/7-day-website/ph">See peso pricing (₱)</a></span></p>
      <nav class="s-svcs" aria-label="All services"><ul>{SERVICE_NAV.map((s) => <li><a href={serviceHref(s.id)}><span class="mono">{s.n.replace('04.', '0')}</span> {s.short}</a></li>)}</ul></nav>
    </div>
  </section>
</Base>
<style>
  /* hero: the pentagon is full-bleed behind the H1 at 35%, the H1 centred on its middle node */
  /* R is capped so the top vertex (and its 01 WEB label) stays ≥56px under the rail: cy − R ≥ header-h + 56 (= data-ftop for the field) */
  .s-hero { --R: min(27vw, 47.25vh, calc(54vh - var(--header-h) - 56px)); --cy: 54vh; position: relative; min-height: 100svh; display: flex; align-items: center; justify-content: center; padding-top: var(--header-h); text-align: center; overflow: hidden; }
  .s-poster { position: absolute; width: calc(var(--R) * 2.5); left: 50%; top: var(--cy); transform: translate(-50%, -50%); }
  .s-hero-in { position: relative; display: grid; gap: 1.5rem; justify-items: center; }
  .s-hero h1 { max-width: none; }
  /* line 2 can be wider than the container's content box: keep the column on the viewport centre (it used to drift right by half the overflow) */
  .s-hero-in { grid-template-columns: minmax(0, 1fr); } .s-hero h1 { width: max-content; justify-self: center; }
  /* two-line rhythm like home: line 2 in gray-400 */
  .s-hero h1 .h-l1, .s-hero h1 .h-l2 { display: block; } .s-hero h1 .h-l2 { color: var(--gray-400); }
  .s-hero h1 .h-l1, .s-hero h1 .h-l2 { white-space: nowrap; }
  @media (max-width: 767px) { .s-hero h1 { font-size: min(8.4vw, 3rem); } } /* "One connected brand." fits 358px at 390 with even 16px gutters */
  .s-deck { max-width: 56ch; }
  .s-cta { display: flex; gap: .75rem; flex-wrap: wrap; justify-content: center; }
  .s-jump a { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; color: var(--gray-300); font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .s-jump a .mono { color: var(--gray-400); }
  .s-jump a:hover, .s-jump a:focus-visible, .s-jump a:hover .mono { color: var(--lime); }
  @media (min-width: 1024px) {
    .s-jump li { position: absolute; left: calc(50% + var(--x) * var(--R)); top: calc(var(--cy) + var(--y) * var(--R)); translate: var(--tx) var(--ty); white-space: nowrap; }
    .s-jump a { padding: 0 6px; }
    /* the H1 is sized off the heptagon: "Seven services." (≈6.9em, one character longer than the old "Five services.") ends
       inside the side vertex labels at every width/height (tuned from the pentagon's .297 by the line-length ratio) */
    .s-hero h1 { font-size: min(var(--fs-d1), calc(var(--R) * .276 - 10px)); }
    /* the heptagon's side vertices sit at ±.975R, level with the deck: keep the deck (and its lines) inside them */
    .s-deck { max-width: min(56ch, calc(var(--R) * 1.95 - 72px)); }
    .s-jump li { --tx: 14px; --ty: -50%; }
    .s-jump li.is-l { --tx: calc(-100% - 14px); }
    .s-jump li.is-t { --tx: -50%; --ty: calc(-100% - 6px); }
  }
  @media (max-width: 1023px) {
    .s-hero { --R: 27vw; }
    .s-hero { flex-direction: column; padding-bottom: 112px; }
    .s-jump { margin-top: 1.5rem; }
    .s-jump ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1rem; padding: 0 var(--side); }
  }
  .chap { padding-block: clamp(96px, 12vh, 160px) 0; }
  .chap-in { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); }
  .chap-side { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 48px); align-self: start; display: grid; gap: 2rem; min-height: 40vh; }
  .chap-n { color: var(--lime); }
  :global(html.gl-live) .chap-glyph { visibility: hidden; }
  .chap-main { grid-column: 6 / span 7; display: grid; gap: 2rem; padding-bottom: var(--section); border-bottom: 1px solid var(--gray-700); }
  .chap-h2 { color: var(--gray-300); }
  .chap-out { color: var(--white); }
  .chap-body { display: grid; gap: 1rem; max-width: 62ch; }
  .chap-cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .chap-cols h3, .chap-proof h3 { margin-bottom: 1rem; font-weight: 400; }
  .ticks { display: grid; gap: .6rem; }
  .ticks li { padding-left: 1.4rem; position: relative; color: var(--gray-200); }
  .ticks li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--lime); }
  .ticks--dim li::before { background: transparent; border: 1px solid var(--gray-400); }
  .chap-proof ul { display: grid; gap: 1.25rem; }
  .chap-proof li { display: grid; gap: .3rem; padding-left: 1rem; border-left: 1px solid var(--gray-700); }
  .chap-proof .link { justify-self: start; }
  @media (max-width: 1023px) { .chap-proof .link { padding-block: 8px; } } /* standalone row: 29 → 45px tap height */
  .chap-time, .chap-read { color: var(--gray-300); }
  .chap-time .mono, .chap-read .mono { margin-right: .75rem; }
  .chap-also { margin-top: -1.25rem; } /* sits under Related reading as one block */
  .chap-cta { justify-self: start; }
  /* the hand-off to the service's own page: a ruled row, not a card */
  .chap-hand { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; min-height: 64px; padding: .75rem 0; border-block: 1px solid var(--gray-700); color: var(--white); transition: border-color .2s, color .2s; }
  .chap-hand .mono { color: var(--lime); }
  .chap-hand-l { font: 600 clamp(1.125rem, 1.6vw, 1.5rem)/1.2 var(--font-display); }
  .chap-hand .arrow { color: var(--lime); transition: transform .2s var(--ease-out); }
  .chap-hand:hover, .chap-hand:focus-visible { border-color: var(--lime); }
  .chap-hand:hover .arrow, .chap-hand:focus-visible .arrow { transform: translateX(4px); }
  .chap-hand:focus-visible { outline: 2px solid var(--lime); outline-offset: 4px; }
  .s-svcs { margin-top: 2.5rem; border-top: 1px solid var(--gray-700); padding-top: 1rem; }
  .s-svcs ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1.75rem; }
  .s-svcs a { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; color: var(--gray-300); }
  .s-svcs a:hover, .s-svcs a:focus-visible { color: var(--lime); }
  .s-faq-in { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 2rem; }
  .s-faq-in > div:first-child { grid-column: 1 / span 4; display: grid; gap: 1rem; align-content: start; }
  .s-faq-in > :global(.faq) { grid-column: 6 / span 7; }
  .s-end { text-align: center; }
  .s-end-in { display: grid; gap: 1.5rem; justify-items: center; position: relative; padding-top: 96px; }
  .s-end h2 { max-width: 14ch; }
  .s-cap { color: var(--lime); }
  .node-anchor { position: absolute; left: 50%; top: 40px; width: 1px; height: 1px; }
  .s-ring { position: absolute; left: 50%; top: 40px; width: 230px; height: 230px; margin: -115px; border-radius: 50%; background: radial-gradient(circle, var(--lime) 0 8px, transparent 8.5px 31px, var(--lime-25) 31.5px 32.5px, transparent 33px 71px, var(--lime-12) 71.5px 72.5px, transparent 73px 111px, rgba(201,255,87,.08) 111.5px 112.5px, transparent 113px); }
  @media (max-width: 1023px) {
    .s-poster { left: 50%; top: 24%; width: 60vw; opacity: .6; }
    .s-hero { align-items: flex-end; padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
    .chap-in > * { grid-column: 1 / -1 !important; }
    .chap-side { position: static; min-height: 0; grid-template-columns: auto 1fr; align-items: center; margin-bottom: 1.5rem; }
    .chap-glyph :global(svg) { width: 56px; height: 56px; }
    :global(html.gl-live) .chap-glyph { visibility: visible; }
    .chap-cols { grid-template-columns: 1fr; }
    .s-faq-in > :global(*) { grid-column: 1 / -1 !important; }
  }
</style>
