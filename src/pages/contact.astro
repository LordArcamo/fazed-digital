---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import { NAP, SITE_URL } from '../data/site';
import { capsCopy } from '../data/proof';
import { crumbs, faqPage, ORG_REF } from '../lib/schema';
const faq = [
  { q: 'How much does a website cost?', a: 'It depends on scope, so we quote every custom project individually. A typical custom website or system runs $5,000–$20,000 depending on features and timeline. If you need something fast and simple, our 7-day packages start at $499 (₱19,999 in the Philippines). You get a detailed quote after the discovery call, with no commitment.' },
  { q: 'How long does a project take?', a: 'Brand identity projects usually take 4–6 weeks. Websites take 4 weeks for simpler builds and 12+ weeks for complex ones. The proposal gives you a clear timeline before anything starts.' },
  { q: 'Do you work with clients outside Iligan City?', a: 'Yes. Most of our case studies are for clients abroad. We work across the Philippines, the USA and Australia, with clear milestones, regular video check-ins and detailed written updates.' },
  { q: 'Do you offer ongoing support?', a: 'Yes. We offer monthly maintenance and support plans for websites (from $99/month or ₱3,500/month), and SEO retainers for continued growth. Ask about options on your discovery call.' },
  { q: 'What do I need to get started?', a: 'Just a conversation. We’ll ask about your business, goals and budget, then put together a proposal. The discovery call is optional: if you’d rather not meet, we can do it all by email. No long intake forms, no homework.' },
  { q: 'Do you work with startups?', a: 'Yes. We like working with early-stage businesses that need a credible presence quickly. CrateOnScene went from idea to live platform in 5 weeks.' },
  { q: 'Will I own my website and domain?', a: 'Yes. Your domain is registered in your name, and you get admin access to hosting and the site. Design files and content are yours once paid for.' },
];
const next = [
  ['01', 'We read it', 'A real person reads your brief. No auto-responder sales funnel.'],
  ['02', 'We reply', 'Within one business day, with questions, a rough scope or an honest “we’re not the right fit”.'],
  ['03', 'We scope it', 'An optional discovery call (or just email), then an itemised proposal and timeline before anything starts. No commitment.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'ContactPage', url: `${SITE_URL}/contact`, name: 'Contact Fazed Digital', about: ORG_REF },
  faqPage(faq),
  crumbs([['Contact', '/contact']]),
];
---
<Base title="Contact Fazed Digital | Get a Free Web Design Quote" description="Get a free quote for web design, branding or SEO. Based in Iligan City, Philippines, working with clients worldwide. We reply within one business day." formation="node" schema={schema} current="/contact">
  <section class="ct-hero" data-f="node" aria-labelledby="ct-h">
    <div class="container ct-in">
      <p class="mono">Signal · {NAP.coords} · Iligan City, PH</p>
      <h1 id="ct-h" class="t-d1">Let’s build <span class="ct-hn" aria-hidden="true"><span class="ct-ring poster-art"></span><span class="node-anchor" data-node-anchor></span></span> something great.</h1>
      <p class="t-body-l ct-deck">Tell us what you need and when you need it. A real person replies within one business day, Monday to Friday.</p>
      <dl class="ct-cells">
        <div><dt class="mono">Email</dt><dd><a class="link" href={`mailto:${NAP.email}`} aria-label={`Email Fazed Digital at ${NAP.email}`}>{NAP.email}</a></dd></div>
        <div><dt class="mono">Phone</dt><dd><a class="link" href={`tel:${NAP.tel}`} aria-label={`Call Fazed Digital on ${NAP.phone}`}>{NAP.phone}</a></dd></div>
        <div><dt class="mono">Hours</dt><dd>Mon–Fri, 8:30am–5:00pm (PHT, UTC+8)</dd></div>
        <div><dt class="mono">Studio</dt><dd>Iligan City, Lanao del Norte, Philippines</dd></div>
      </dl>
      <p class="ct-small">Outside our hours? Send the form anyway. It’ll be first in the queue the next working morning.</p>
    </div>
  </section>
  <section class="section container ct-next" aria-labelledby="n-h">
    <h2 id="n-h" class="t-d2">What happens after you hit send</h2>
    <ol>{next.map(([n, t, b]) => <li class="rv"><span class="ct-node" aria-hidden="true"></span><span class="mono">{n}</span><h3 class="t-h3">{t}</h3><p>{b}</p></li>)}</ol>
  </section>
  <section class="section container ct-form" id="brief" aria-label="Send us your brief">
    <div class="ct-form-side"><p class="mono ct-cap">{capsCopy.custom}</p><p>Need a simple site live this week? <a class="link" href="/lp/7-day-website">Get live in 7 days</a> · <a class="link" href="/lp/7-day-website/ph">See peso pricing (₱)</a></p></div>
    <ContactForm id="contact-cf" />
  </section>
  <section class="section container ct-faq" data-f="lattice" aria-labelledby="f-h">
    <div><p class="mono">FAQ · 07</p><h2 id="f-h" class="t-d2">Questions, answered.</h2></div>
    <Faq items={faq} id="cfaq" />
  </section>
</Base>
<style>
  .ct-hero { position: relative; min-height: 100svh; display: flex; align-items: center; padding-top: calc(var(--header-h) + 160px); padding-bottom: 72px; }
  /* the contact node sits inline in the H1, on the x-height of the line */
  .ct-hn { position: relative; display: inline-block; width: .5em; height: .5em; vertical-align: baseline; }
  .node-anchor { position: absolute; left: 50%; top: 50%; width: 1px; height: 1px; }
  .ct-ring { position: absolute; left: 50%; top: 50%; width: 230px; height: 230px; margin: -115px; border-radius: 50%; background: radial-gradient(circle, var(--lime) 0 8px, transparent 8.5px 31px, var(--lime-25) 31.5px 32.5px, transparent 33px 71px, var(--lime-12) 71.5px 72.5px, transparent 73px 111px, rgba(201,255,87,.08) 111.5px 112.5px, transparent 113px); }
  .ct-in { position: relative; z-index: 0; display: grid; gap: 1.5rem; }
  .ct-ring { z-index: -1; }
  .ct-in h1 { max-width: 12ch; }
  .ct-deck { max-width: 44ch; }
  .ct-cells { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 1rem 3rem; margin-top: 1rem; }
  .ct-cells dd { margin-top: .3rem; color: var(--gray-200); font-size: 1.1rem; }
  .ct-cells a { display: inline-flex; min-height: 44px; align-items: center; }
  .ct-small { color: var(--gray-400); font-size: .95rem; }
  .ct-next { display: grid; gap: 3rem; }
  .ct-next ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .ct-next li { display: grid; gap: .6rem; align-content: start; padding-top: 1.5rem; border-top: 1px solid var(--gray-700); position: relative; }
  .ct-node { position: absolute; top: -6px; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--lime); }
  @media (max-width: 1023px) { .ct-cells dd > .link { display: inline-block; padding-block: 8px; } }
  .ct-form { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 2rem; padding-top: 0; }
  .ct-form-side { grid-column: 1 / span 4; display: grid; gap: 1rem; align-content: start; }
  .ct-form > :global(.cf) { grid-column: 6 / span 7; }
  .ct-cap { color: var(--lime); }
  .ct-faq { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); row-gap: 2rem; }
  .ct-faq > div:first-child { grid-column: 1 / span 4; display: grid; gap: 1rem; align-content: start; }
  .ct-faq > :global(.faq) { grid-column: 6 / span 7; }
  @media (max-width: 1023px) {
    .ct-cells { grid-template-columns: 1fr 1fr; }
    .ct-next ol { grid-template-columns: 1fr; }
    .ct-form > :global(*), .ct-faq > :global(*) { grid-column: 1 / -1 !important; }
    .ct-hero { align-items: flex-end; padding-top: 200px; padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 599px) { .ct-cells { grid-template-columns: 1fr; } }
</style>
