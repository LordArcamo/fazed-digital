---
// /framer and /webflow: one template, data in src/data/nocode.ts. Builds are concept sites for fictional brands
// (labelled on every card), never client work. Prices: only the published 7-day packages; platform builds are quoted.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import { builds, platforms, choose, NOCODE_LABEL, type Platform } from '../data/nocode';
import { nocodeImages } from '../data/images';
import { SITE_URL } from '../data/site';
import { crumbs, faqPage, ORG_REF } from '../lib/schema';

const { platform } = Astro.props as { platform: Platform };
const p = platforms[platform];
const other = platform === 'framer' ? platforms.webflow : platforms.framer;
const mine = builds.filter((b) => b.platform === platform);
const theirs = builds.filter((b) => b.platform !== platform);
const url = SITE_URL + p.path;
const fmt = (iso: string) => new Date(iso + 'T00:00:00+08:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Manila' });
const steps = [
  ['01', 'Short call', 'What the site must do, who it’s for, and what you already have. You get a price and a timeline upfront.'],
  ['02', 'Direction', 'A look and a page plan, agreed before we build, so there are no surprises later.'],
  ['03', 'Build', `Every page in ${p.name}, designed for desktop, tablet and phone, with forms, motion and SEO basics in place.`],
  ['04', 'Review', 'You test it on a staging link and we make the changes.'],
  ['05', 'Publish and hand over', `We connect your domain and hand over the ${p.name} project, with a walkthrough of how to edit it.`],
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': `${url}#service`, name: `${p.name} website design and development`,
    serviceType: `${p.name} website design`, description: p.description, url, provider: ORG_REF, areaServed: 'Worldwide',
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: `Fazed Digital ${p.name} concept sites`,
    itemListElement: mine.map((b, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'CreativeWork', name: `${b.brand} (concept site, fictional brand)`, url: b.url, dateCreated: b.date, creator: ORG_REF } })),
  },
  faqPage(p.faq as unknown as { q: string; a: string }[]),
  crumbs([['Services', '/services'], [`${p.name} websites`, p.path]]),
];
---
<Base title={p.title} description={p.description} image={`/og/${platform}.png`} formation="lattice" schema={schema}>
  <div class="pf">
    <section class="pf-hero" aria-labelledby="pf-h">
      <div class="container pf-hero-in">
        <p class="mono pf-eye">{p.eyebrow}</p>
        <h1 id="pf-h" class="t-d1">{p.h1[0]} <span class="dim">{p.h1[1]}</span></h1>
        <p class="t-body-l pf-deck">{p.deck}</p>
        <div class="pf-cta">
          <a class="btn btn--lime" href="/contact?service=web" data-magnetic>Talk about your {p.name} site <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="#builds">See our {p.name} builds</a>
        </div>
      </div>
    </section>

    <section class="container pf-sec" id="builds" aria-labelledby="b-h">
      <div class="pf-hd"><p class="mono">Built in {p.name} · {String(mine.length).padStart(2, '0')}</p><h2 id="b-h" class="t-d2">Our {p.name} builds. <span class="dim">Open them, click around.</span></h2></div>
      <ul class="pf-builds">
        {mine.map((b, i) => (
          <li class="pf-b rv">
            <a class="pf-shot" href={b.url} target="_blank" rel="noopener" data-cursor="OPEN ↗" aria-label={`Open the ${b.brand} concept site (opens in a new tab)`}>
              <Picture src={nocodeImages[b.id]} formats={['avif', 'webp']} widths={[640, 1024, 1440]} sizes="(max-width: 1023px) 92vw, 60vw" alt={b.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </a>
            <div class="pf-b-txt">
              <p class="mono pf-meta"><span>{b.category}</span><span>{fmt(b.date)}</span></p>
              <h3 class="t-d2 pf-brand">{b.brand}</h3>
              <p class="pf-line">“{b.line}”</p>
              <p>{b.what}</p>
              <ul class="pf-chips"><li class="chip chip--lab">{NOCODE_LABEL}</li>{b.chips.map((c) => <li class="chip">{c}</li>)}</ul>
              <a class="link" href={b.url} target="_blank" rel="noopener">Open {b.host} ↗<span class="sr-only"> (opens in a new tab)</span></a>
            </div>
          </li>
        ))}
      </ul>
      <p class="pf-honest mono">Concept sites for fictional brands, built by our team. Not client work. Client case studies are on <a class="link" href="/work">Work</a>.</p>
    </section>

    <section class="container pf-sec" aria-labelledby="s-h">
      <div class="pf-hd"><p class="mono">What we set up</p><h2 id="s-h" class="t-d2">Everything a {p.name} site needs <span class="dim">to work on day one.</span></h2></div>
      <ul class="pf-cards">{p.setup.map(([t, d]) => <li class="rv"><h3 class="t-h3">{t}</h3><p>{d}</p></li>)}</ul>
    </section>

    <section class="container pf-sec" aria-labelledby="c-h">
      <div class="pf-hd"><p class="mono">Framer, Webflow or code?</p><h2 id="c-h" class="t-d2">We build in all three, <span class="dim">so we’ll tell you which fits.</span></h2></div>
      <ul class="pf-choose">{choose.map(([n, d, h]) => (
        <li class:list={['rv', { on: n === p.name }]}>
          <h3 class="t-h3">{n}</h3><p>{d}</p>
          {n !== p.name && <a class="link" href={h}>{n === 'Custom code' ? 'Custom websites' : `${n} websites`} →</a>}
        </li>
      ))}</ul>
    </section>

    <section class="container pf-sec" aria-labelledby="h-h">
      <div class="pf-hd"><p class="mono">How it works</p><h2 id="h-h" class="t-d2">From call to live, <span class="dim">in five steps.</span></h2></div>
      <ol class="pf-steps">{steps.map(([n, t, d]) => <li class="rv"><span class="mono">{n}</span><b>{t}</b><span>{d}</span></li>)}</ol>
    </section>

    {theirs.length > 0 && (
      <section class="container pf-sec" aria-labelledby="o-h">
        <div class="pf-hd"><p class="mono">Also built in {other.name}</p><h2 id="o-h" class="t-d2">Prefer {other.name}? <span class="dim">We build there too.</span></h2></div>
        <ul class="pf-also">{theirs.map((b) => (
          <li class="rv"><a href={other.path}>
            <Picture src={nocodeImages[b.id]} formats={['avif', 'webp']} widths={[480, 800]} sizes="(max-width: 767px) 92vw, 30vw" alt={b.alt} loading="lazy" decoding="async" />
            <span class="mono">{b.category}</span><b>{b.brand}</b>
          </a></li>
        ))}</ul>
        <a class="link" href={other.path}>{other.name} websites →</a>
      </section>
    )}

    <section class="container pf-sec" aria-labelledby="f-h">
      <div class="pf-hd"><p class="mono">FAQ</p><h2 id="f-h" class="t-d2">Questions about {p.name}.</h2></div>
      <Faq items={p.faq as unknown as { q: string; a: string }[]} id={`${platform}-faq`} />
    </section>

    <section class="pf-end on-lime" aria-label="Get started">
      <div class="container pf-end-in">
        <div><p class="t-h3">Got a {p.name} site in mind?</p><p>Tell us what it needs to do. A real person replies within one business day, with a price and a timeline.</p></div>
        <div class="pf-end-btns">
          <a class="btn btn--black" href="/contact?service=web">Get a {p.name} quote <span class="arrow" aria-hidden="true">→</span></a>
          <a class="pf-end-link" href="/audit">Or book a free 15-minute website check</a>
        </div>
      </div>
    </section>
  </div>
</Base>
<style>
  .pf-hero { padding: calc(var(--header-h) + 96px) 0 48px; }
  .pf-hero-in { display: grid; gap: 1.5rem; }
  .pf-hero h1 { max-width: 16ch; }
  .pf-eye { color: var(--lime); }
  .pf-deck { max-width: 60ch; }
  .pf-cta { display: flex; flex-wrap: wrap; gap: .75rem; }
  .pf-sec { display: grid; gap: 2rem; padding-block: clamp(48px, 6vw, 96px); }
  .pf-hd { display: grid; gap: .75rem; }
  .pf-sec > .link { justify-self: start; }
  .pf-builds { display: grid; gap: clamp(48px, 6vw, 88px); }
  .pf-b { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 1.5rem var(--gutter); align-items: center; }
  .pf-b:nth-child(even) .pf-shot { order: 2; }
  .pf-shot { display: block; border: 1px solid var(--gray-700); border-radius: 12px; overflow: hidden; transition: border-color .2s, transform .4s var(--ease-out); }
  .pf-shot:hover, .pf-shot:focus-visible { border-color: var(--lime); transform: translateY(-4px); }
  .pf-shot :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .pf-b-txt { display: grid; gap: .9rem; justify-items: start; }
  .pf-b-txt > p:not(.mono) { color: var(--gray-300); max-width: 52ch; }
  .pf-meta { display: flex; gap: 1rem; color: var(--lime); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .pf-meta span + span { color: var(--gray-400); }
  .pf-b-txt .pf-line { color: var(--white); font-family: var(--font-display); font-size: 1.15rem; }
  .pf-brand { font-size: clamp(2rem, 4vw, 3.25rem); }
  .pf-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .pf-chips .chip { min-height: 30px; padding: 0 .7rem; font-size: 11px; color: var(--gray-300); }
  .pf-chips .chip--lab { border-color: var(--lime); color: var(--lime); }
  .pf-honest { color: var(--gray-400); font-size: 12px; letter-spacing: .06em; }
  .pf-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .pf-cards li, .pf-choose li { display: grid; gap: .75rem; align-content: start; padding: 24px; border: 1px solid var(--gray-700); border-radius: 14px; background: var(--gray-900); }
  .pf-cards p, .pf-choose p { color: var(--gray-300); }
  .pf-choose { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .pf-choose li.on { border-color: var(--lime); }
  .pf-steps { display: grid; border-top: 1px solid var(--gray-700); max-width: 900px; }
  .pf-steps li { display: grid; grid-template-columns: 4rem 14rem minmax(0, 1fr); column-gap: 1rem; padding-block: 16px; border-bottom: 1px solid var(--gray-700); }
  .pf-steps .mono { color: var(--lime); }
  .pf-steps span:last-child { color: var(--gray-300); }
  .pf-also { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .pf-also a { display: grid; gap: .4rem; }
  .pf-also :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border: 1px solid var(--gray-700); border-radius: 10px; transition: border-color .2s; }
  .pf-also a:hover :global(img) { border-color: var(--lime); }
  .pf-also .mono { color: var(--lime); font-size: 12px; letter-spacing: .1em; }
  .pf-end { padding: 64px 0; margin-top: 32px; }
  .pf-end-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .pf-end-in p { color: var(--black); max-width: 56ch; }
  .pf-end-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .pf-end-link { color: var(--black); font-weight: 600; text-decoration: underline; text-underline-offset: .2em; min-height: 44px; display: inline-flex; align-items: center; }
  @media (max-width: 1023px) {
    .pf-b { grid-template-columns: 1fr; } .pf-b:nth-child(even) .pf-shot { order: 0; }
    .pf-cards, .pf-choose { grid-template-columns: 1fr 1fr; } .pf-choose li:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 767px) {
    .pf-hero { padding-top: calc(var(--header-h) + 48px); }
    .pf-cards, .pf-choose, .pf-also { grid-template-columns: 1fr; }
    .pf-steps li { grid-template-columns: 3rem minmax(0, 1fr); } .pf-steps li > span:last-child { grid-column: 2; }
    .pf-cta .btn, .pf-end-btns .btn { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .pf-shot { transition: border-color .2s; } .pf-shot:hover { transform: none; } }
</style>
