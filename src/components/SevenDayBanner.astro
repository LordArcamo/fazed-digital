---
/**
 * 7-Day Website offer banner.
 * On-site entry point to the landing pages (/lp/7-day-website + /ph).
 * Static — no JS. Drop into any page before the footer.
 */
---
<section style="padding: clamp(4rem,8vw,7rem) 0; background: var(--gray-900); border-top: 1px solid var(--border); position: relative; overflow: hidden;">
  <!-- Lime glow + rings (matches services CTA aesthetic) -->
  <div aria-hidden style="position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 120%, rgba(201,255,87,0.08) 0%, transparent 60%); pointer-events: none;"></div>
  <div aria-hidden style="position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: clamp(360px,55vw,820px); aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(201,255,87,0.06); pointer-events: none;"></div>

  <div class="container" style="position: relative; z-index: 1;">
    <div class="seven-grid" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem,5vw,5rem); align-items: center;">
      <!-- Copy -->
      <div>
        <div class="label" style="color: var(--accent); margin-bottom: 1.25rem;">⚡ Fast-Track Offer</div>
        <h2 style="font-family: var(--font-display); font-size: clamp(2rem,4.5vw,3.5rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.02; color: var(--white); margin-bottom: 1.25rem;">
          Need a website live in <span style="font-style: italic; color: var(--accent);">7 days?</span>
        </h2>
        <p class="body-lg" style="color: var(--gray-400); max-width: 46ch; line-height: 1.7;">
          A professional, mobile-ready, SEO-optimized website for your small business — designed, built, and launched in one week. No drawn-out timelines, no surprises.
        </p>
      </div>

      <!-- CTA block -->
      <div style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;">
        <a href="/lp/7-day-website"
          style="display: inline-flex; align-items: center; gap: 0.6rem; padding: 1rem 2rem; border-radius: 100px; background: var(--accent); color: var(--black); font-family: var(--font-body); font-weight: 600; font-size: 1rem; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 0 0 rgba(201,255,87,0);"
          onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 30px rgba(201,255,87,0.25)';"
          onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0 0 rgba(201,255,87,0)';">
          See the 7-Day Package →
        </a>
        <a href="/lp/7-day-website/ph"
          style="font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.06em; color: var(--gray-400); padding-left: 0.25rem; transition: color 0.2s;"
          onmouseover="this.style.color='var(--accent)';"
          onmouseout="this.style.color='var(--gray-400)';">
          🇵🇭 View Philippine peso pricing →
        </a>
      </div>
    </div>
  </div>

  <style>
    @media (max-width: 760px) {
      .seven-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</section>
