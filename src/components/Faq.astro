---
const { items, id = 'faq' } = Astro.props as { items: { q: string; a: string }[]; id?: string };
---
<div class="faq" id={id} data-faq>
  {items.map((f, i) => (
    <details class="faq-i">
      <summary><span class="mono faq-n">{String(i + 1).padStart(2, '0')}</span><span class="faq-q">{f.q}</span><span class="faq-x" aria-hidden="true"></span></summary>
      <div class="faq-a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
<script>
  // One open at a time, and height animates both ways: a bare <details> snaps. Without script it still opens and closes.
  const OPEN = { duration: 560, easing: 'cubic-bezier(.16, 1, .3, 1)' }, CLOSE = { duration: 420, easing: 'cubic-bezier(.65, 0, .35, 1)' };
  const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const settle = () => document.dispatchEvent(new CustomEvent('fz:layout')); // everything below moved: ScrollTrigger re-measures
  const slide = (d: HTMLDetailsElement, open: boolean) => {
    const a = d.querySelector<HTMLElement>('.faq-a')!;
    const from = d.open ? a.offsetHeight : 0; // a closed <details> can still report its full height
    a.getAnimations().forEach((x) => x.cancel());
    d.classList.toggle('is-shut', !open);
    if (open) d.open = true;
    if (still()) { d.open = open; d.classList.remove('is-shut'); settle(); return; }
    const to = open ? a.scrollHeight : 0;
    const run = a.animate({ height: [`${from}px`, `${to}px`], opacity: [open ? 0 : 1, open ? 1 : 0] }, open ? OPEN : CLOSE);
    run.onfinish = () => { if (!open) d.open = false; d.classList.remove('is-shut'); settle(); };
  };
  const initFaq = () => document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    if (root.dataset.bound) return;
    root.dataset.bound = '1';
    root.addEventListener('click', (e) => {
      const s = (e.target as HTMLElement).closest('summary');
      if (!s) return;
      e.preventDefault();
      const d = s.parentElement as HTMLDetailsElement;
      const opening = !d.open || d.classList.contains('is-shut');
      root.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((x) => { if (x !== d && !x.classList.contains('is-shut')) slide(x, false); });
      slide(d, opening);
    });
  });
  document.addEventListener('astro:page-load', initFaq);
  initFaq();
</script>
<style>
  .faq { border-top: 1px solid var(--gray-700); }
  .faq-i { border-bottom: 1px solid var(--gray-700); }
  summary { list-style: none; display: grid; grid-template-columns: 3rem 1fr 24px; gap: 1rem; align-items: center; min-height: 64px; padding: 1rem 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .faq-q { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; color: var(--white); line-height: 1.2; }
  .faq-x { width: 14px; height: 14px; position: relative; justify-self: end; }
  .faq-x::before, .faq-x::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--lime); transition: transform .5s var(--ease-out); }
  .faq-x::after { transform: rotate(90deg); }
  details[open]:not(.is-shut) .faq-x::after { transform: rotate(0); }
  summary:hover .faq-q { color: var(--lime); }
  .faq-a { overflow: hidden; }
  .faq-i p { padding: 0 2rem 1.5rem 4rem; max-width: 68ch; }
  @media (max-width: 767px) { .faq-i p { padding-left: 0; } summary { grid-template-columns: 2.25rem 1fr 20px; } }
</style>
