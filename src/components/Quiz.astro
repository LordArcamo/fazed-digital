---
// Website quiz (/quiz). Form-first: the first screen IS the quiz start. One question per screen, tap to answer.
// Content: src/data/quiz.ts (copy/quiz.md). Engine: src/forms/quiz.ts, loaded at once by the shell script below
// (dynamic import: the page's eager JS stays tiny, and no gsap/three import). Leads: /api/lp-submit (kind: 'quiz').
import { Image } from 'astro:assets';
import {
  start, chrome, questions, NO_SITE, coachExtra, areas, AREA_PRIORITY, areaLevels, fixes, bands, buildingLine,
  nextSteps, result, bizPhrase, nosite, casesByBiz, msg, QUIZ_RESULT_EMAIL,
} from '../data/quiz';
import { caseIndex } from '../data/cases';
import { workImages } from '../data/images';
import { capsCopy } from '../data/proof';
import { BOOK } from '../data/site';

// PREVIEW: in local dev the email gate never calls the API (the engine also treats localhost and ?preview as preview)
const preview = import.meta.env.DEV;
const usedCases = [...new Set(Object.values(casesByBiz).flatMap((c) => c.slugs))];
const cases = caseIndex.filter((c) => usedCases.includes(c.slug));

// Everything the browser needs, as plain JSON (functions → {name}/{email}/{biz}/{n}/{p} templates)
const data = {
  preview, emailLive: QUIZ_RESULT_EMAIL, noSite: NO_SITE,
  q: questions.map((q) => ({ id: q.id, n: q.n, kind: q.kind, path: q.path, area: q.area, none: q.none, cap: q.cap, h: q.h, hint: q.hint, hintBuilding: q.hintBuilding, opts: q.options.map((o) => ({ v: o.v, label: o.label, pts: o.pts, coach: o.coach })) })),
  areas, priority: AREA_PRIORITY, levels: areaLevels, fixes, bands, bizPhrase,
  next: {
    sevenday: { h: nextSteps.sevenday.h, body: { usd: nextSteps.sevenday.body(nextSteps.sevenday.price.usd), php: nextSteps.sevenday.body(nextSteps.sevenday.price.php) }, cta: nextSteps.sevenday.cta, href: nextSteps.sevenday.href },
    audit: nextSteps.audit, branding: nextSteps.service.branding, web: nextSteps.service.web, seo: nextSteps.seo,
  },
  nosite: { ...nosite, timeline: { ...nosite.timeline, asap: capsCopy.sevenDay } },
  cases: casesByBiz,
  t: {
    of: chrome.of, hint: chrome.hint(9).replace('9', '{n}'), hintMulti: chrome.hintMulti(9).replace('9', '{n}'),
    coachProof: coachExtra.proofStrong, coachLast: coachExtra.last, adding: chrome.adding, building: buildingLine,
    resume: start.resume, label: result.label, fixesH: result.fixesH, fixesSub: result.fixesSub, noFixesH: result.noFixesH, noFixesSub: result.noFixesSub,
    example: result.example, before: result.before, after: result.after, why: result.why, locked: result.lockedTag,
    gateLine: result.gateLine('{biz}'), gateSending: result.gateSending, doneH: result.doneH('{name}', '{email}'),
    bookUnder: result.book.under, bookUnderNoSite: result.book.underNoSite,
    casesMatch: result.casesH.match, casesLocal: result.casesH.local, casesAny: result.casesH.any,
    shareText: result.shareText, shared: result.shared, nosLabel: nosite.label,
  },
  msg,
};
const hp = 'quiz-hp';
---
<section class="qz" data-quiz aria-labelledby="qz-h">
  <script type="application/json" data-quiz-data set:html={JSON.stringify(data)} />
  <p class="qz-preview mono" aria-hidden="true">Preview · nothing is sent</p>
  <div class="container qz-in">

    <!-- ── Start ── -->
    <div class="qz-start" data-start-screen>
      <div class="qz-start-tx">
        <p class="mono qz-eyebrow"><span class="qz-dot" aria-hidden="true"></span>{start.eyebrow}</p>
        <h1 id="qz-h" class="qz-h1">{start.h1[0]} <span class="dim">{start.h1[1]}</span></h1>
        <p class="qz-sub">{start.sub}</p>
        <p class="qz-tip"><span class="qz-eye" aria-hidden="true"></span>{start.tip}</p>
        <div class="qz-go-row">
          <button type="button" class="btn btn--lime qz-go" data-go data-cursor="GO →"><span data-go-label>{start.cta}</span> <span class="arrow" aria-hidden="true">→</span></button>
          <a class="qz-book-link" href={BOOK} target="_blank" rel="noopener" data-book="start">{start.book}<span class="sr-only"> (opens the booking calendar)</span></a>
        </div>
        <p class="mono qz-under">{start.under}</p>
        <p class="qz-resume" data-resume-row hidden><button type="button" class="qz-textbtn" data-restart>{start.restart}</button></p>
        <noscript><p class="qz-nojs">{start.noJs} <a class="link" href={BOOK} target="_blank" rel="noopener">Book a 15-min call</a></p></noscript>
      </div>
      <!-- the reward, previewed: the score card they get at the end (decorative) -->
      <div class="qz-card" aria-hidden="true">
        <p class="mono qz-card-hd"><span>{result.label}</span><span>12 taps</span></p>
        <p class="qz-card-score"><span class="qz-card-q">??</span><span class="qz-of">/100</span></p>
        <ol class="qz-card-areas">{areas.map((a, i) => <li style={`--i:${i}`}><span>{a.name}</span><i></i></li>)}</ol>
        <p class="mono qz-card-ft"><span>= Your 3 biggest fixes</span><span class="qz-card-lock"></span></p>
      </div>
      <ul class="qz-trust mono">{start.trust.map((t) => <li>{t}</li>)}</ul>
    </div>

    <!-- ── Question chrome ── -->
    <div class="qz-top" data-top hidden>
      <button type="button" class="qz-back" data-back><span aria-hidden="true">←</span> {chrome.back}</button>
      <p class="mono qz-count" data-count aria-hidden="true"></p>
      <div class="qz-bar" aria-hidden="true"><span data-bar></span></div>
    </div>

    <form class="qz-form" data-form novalidate hidden aria-labelledby="qz-h">
      <p class="qz-coach" data-coach role="status" aria-live="polite"></p>
      {questions.map((q) => (
        <fieldset class="q" data-q={q.id} data-kind={q.kind} data-path={q.path} hidden>
          <legend class="q-lg">
            <h2 class="q-h" data-h tabindex="-1">{q.h}</h2>
          </legend>
          {q.hint && <p class="q-hint"><span class="qz-eye" aria-hidden="true"></span><span data-qhint data-alt={q.hintBuilding}>{q.hint}</span></p>}
          <div class:list={['q-opts', q.options.length > 4 && 'q-opts--many']}>{q.options.map((o, i) => (
            <label class:list={['qt', q.kind === 'multi' && 'qt--multi', o.v === q.none && 'qt--none']}>
              <input type={q.kind === 'multi' ? 'checkbox' : 'radio'} name={q.id} value={o.v} />
              <span class="qt-b"><span class="qt-k" aria-hidden="true">{i + 1}</span><span class="qt-t" data-opt>{o.label}</span><span class="qt-node" aria-hidden="true"></span></span>
            </label>
          ))}</div>
          {q.kind === 'multi' && <button type="button" class="btn btn--lime q-next" data-next>{chrome.multiNext} <span class="arrow" aria-hidden="true">→</span></button>}
          <p class="q-err" data-err role="alert"></p>
        </fieldset>
      ))}
      <p class="mono q-keys" data-hint aria-hidden="true"></p>
      <p class="sr-only" data-live role="status" aria-live="polite"></p>
    </form>

    <div class="qz-adding" data-adding hidden role="status">
      <span class="qz-adding-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <p class="qz-adding-t" data-adding-t>{chrome.adding}</p>
    </div>

    <!-- ── Result ── -->
    <div class="qz-res" data-result hidden>
      <div class="qz-res-grid">
        <div class="qz-res-main">
          <header class="qz-res-hd">
            <p class="mono qz-res-label" data-res-label>{result.label}</p>
            <p class="qz-score qz-site" aria-hidden="true"><span class="qz-num" data-score>0</span><span class="qz-of">{result.of}</span></p>
            <p class="mono qz-band qz-site" data-band-name></p>
            <h2 class="qz-res-h" data-res-h tabindex="-1"><span class="sr-only" data-score-sr></span><span data-res-h-t></span></h2>
            <p class="qz-res-sum" data-res-sum></p>
            <p class="qz-building" data-building hidden><span class="qz-dot" aria-hidden="true"></span>{buildingLine}</p>
          </header>

          <section class="qz-areas qz-site" aria-labelledby="qz-areas-h">
            <h3 class="mono qz-sec-h" id="qz-areas-h">{result.areasH}</h3>
            <ol>{areas.map((a) => (
              <li data-area-row={a.id}><span class="qz-area-n">{a.name}</span><span class="qz-meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span class="mono qz-area-l" data-area-l></span><span class="mono qz-area-v" data-area-v></span></li>
            ))}</ol>
          </section>

          <section class="qz-plan qz-nosite" aria-labelledby="qz-plan-h">
            <h3 class="mono qz-sec-h" id="qz-plan-h">{nosite.planH}</h3>
            <div class="qz-plan-card">
              <p class="qz-plan-pk"><span data-plan-name></span> <span class="qz-plan-price" data-plan-price></span></p>
              <p data-plan-line></p>
              <p class="qz-plan-fixed">{nosite.fixed}</p>
              <p class="qz-plan-fb" data-plan-fb hidden>{nosite.facebookPH}</p>
              <p class="mono qz-plan-when" data-plan-when></p>
            </div>
            <h3 class="mono qz-sec-h">{nosite.answersH}</h3>
            <dl class="qz-plan-dl" data-plan-dl></dl>
          </section>

          <section class="qz-fixes qz-site" aria-labelledby="qz-fixes-h">
            <h3 class="qz-fixes-h" id="qz-fixes-h" data-fixes-h>{result.fixesH}</h3>
            <p class="qz-fixes-sub" data-fixes-sub>{result.fixesSub}</p>
            <ol class="qz-fx-list" data-fixes></ol>

            <div class="qz-gate-wrap" data-gate-wrap>
              <form class="qz-gate" data-gate novalidate aria-labelledby="qz-gate-l">
                <p class="qz-gate-l" id="qz-gate-l" data-gate-line></p>
                <div class="hp" aria-hidden="true"><label for={hp}>Leave this field empty</label><input id={hp} name="fz_check" tabindex="-1" autocomplete="off" /></div>
                <div class="qz-fields">
                  <div class="f"><label for="qz-n">{result.gateName}</label><input id="qz-n" name="name" autocomplete="given-name" autocapitalize="words" enterkeyhint="next" required /></div>
                  <div class="f"><label for="qz-e">{result.gateEmail}</label><input id="qz-e" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" enterkeyhint="next" required /><p class="q-typo" data-typo hidden>Did you mean <button type="button" data-typo-fix></button>?</p></div>
                  <div class="f f--wide"><label for="qz-w">{result.gateSite}</label><input id="qz-w" name="currentWebsite" inputmode="url" autocapitalize="off" spellcheck="false" autocomplete="url" enterkeyhint="send" placeholder={result.gateSitePh} /></div>
                </div>
                <p class="q-err" data-gate-err role="alert"></p>
                <button type="submit" class="btn btn--lime qz-gate-btn" data-gate-btn data-cursor="SEND"><span data-gate-label>{result.gateCta}</span> <span class="arrow" aria-hidden="true">→</span></button>
                {result.gateUnder && <p class="mono qz-gate-under">{result.gateUnder}</p>}
                <p class="qz-fine">{result.privacy} <a class="link" href="/privacy" target="_blank" rel="noopener">Our privacy policy<span class="sr-only"> (opens in a new tab)</span></a>. Protected by reCAPTCHA: Google’s <a class="link" href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy<span class="sr-only"> (opens in a new tab)</span></a> and <a class="link" href="https://policies.google.com/terms" target="_blank" rel="noopener">Terms<span class="sr-only"> (opens in a new tab)</span></a> apply.</p>
              </form>
              <div class="qz-done" data-gate-done hidden>
                <p class="qz-done-h" data-done-h tabindex="-1"></p>
                <p class="qz-done-help"><strong>{result.helpH}</strong> {result.helpBody}</p>
                <a class="btn btn--lime" href={BOOK} target="_blank" rel="noopener" data-book="after-fixes">{result.book.cta} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens the booking calendar)</span></a>
                {result.spam && <p class="mono qz-gate-under">{result.spam}</p>}
              </div>
            </div>
          </section>
        </div>

        <aside class="qz-res-side" aria-label="Next steps">
          <div class="qz-bookcard">
            <img class="qz-lord" src="/images/team/lord.jpeg" width="96" height="96" alt={result.book.alt} loading="lazy" decoding="async" />
            <p class="mono qz-bk-eb">{result.book.eyebrow}</p>
            <a class="btn btn--lime qz-bk-btn" href={BOOK} target="_blank" rel="noopener" data-book="result" data-cursor="BOOK">{result.book.cta} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens the booking calendar)</span></a>
            <p class="mono qz-bk-under" data-book-under>{result.book.under}</p>
          </div>
          <div class="qz-next" data-next-card>
            <p class="qz-next-h" data-next-h></p>
            <p class="qz-next-b" data-next-b></p>
            <a class="btn btn--ghost qz-next-a" href="/lp/7-day-website" data-next-link><span data-next-cta></span> <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </aside>
      </div>

      <section class="qz-cases" aria-labelledby="qz-cases-h">
        <h3 class="mono qz-sec-h" id="qz-cases-h" data-cases-h>{result.casesH.match}</h3>
        <ul class="qz-case-list" data-cases>{cases.map((c) => (
          <li class="qz-case" data-case={c.slug} hidden>
            <a href={`/work/${c.slug}`} data-case-link>
              <Image src={workImages[c.slug]} alt={c.alt} widths={[360, 640]} sizes="(min-width: 1024px) 400px, 92vw" loading="lazy" class="qz-case-img" />
              <span class="mono qz-case-m">{c.sector} · {c.country}</span>
              <span class="qz-case-t">{c.title}</span>
              <span class="qz-case-c">{c.changed}</span>
            </a>
          </li>
        ))}</ul>
      </section>

      <div class="qz-again">
        <button type="button" class="btn btn--ghost" data-share>{result.share}</button>
        <button type="button" class="qz-textbtn" data-retake>{result.retake}</button>
        <span class="mono qz-share-note" data-share-note role="status" aria-live="polite"></span>
      </div>
      <p class="qz-foot">{result.footnote}</p>
    </div>
  </div>
</section>

<script>
  // Eager shell (tiny): binds once per page and loads the engine right away. A Start tap before the engine lands is
  // remembered (data-pending) and replayed. ClientRouter: guarded with dataset.bound, run now and on astro:page-load.
  function initQuizShell() {
    const root = document.querySelector<HTMLElement>('[data-quiz]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    root.querySelector('[data-go]')?.addEventListener('click', () => { if (!root.classList.contains('is-ready')) root.dataset.pending = '1'; });
    import('../forms/quiz').then((m) => m.initQuiz(root));
  }
  initQuizShell();
  document.addEventListener('astro:page-load', initQuizShell);
</script>

<style>
  .qz [hidden] { display: none !important; }
  :global(html.quiz-q #cookie) { display: none !important; }
  .qz { position: relative; min-height: var(--screen-h, 100svh); padding: calc(var(--header-h) + 8px) 0 clamp(48px, 6vw, 96px); display: flex; }
  .qz-in { display: flex; flex-direction: column; justify-content: center; flex: 1; }
  /* questions and the result start near the top (the answers stay in thumb reach); only the start screen is centred */
  .qz:is([data-view='q'], [data-view='result']) .qz-in { justify-content: flex-start; padding-top: clamp(8px, 4vh, 56px); }
  :global(html.js) .qz-start { animation: qz-in .5s var(--ease-out) both; }
  @keyframes qz-in { from { opacity: 0; translate: 0 12px; } }
  .qz-preview { display: none; white-space: nowrap; position: fixed; left: 50%; bottom: 12px; translate: -50% 0; z-index: 60; padding: 6px 12px; border-radius: 999px; background: var(--gray-800); border: 1px dashed var(--lime); color: var(--lime); pointer-events: none; }
  .qz.is-preview .qz-preview { display: block; }

  /* ── Start ─────────────────────────────────────────────── */
  .qz-start { display: grid; gap: 1.25rem; align-items: center; }
  .qz-start-tx { display: grid; gap: 1.1rem; justify-items: start; }
  .qz-eyebrow { display: inline-flex; align-items: center; gap: .6rem; color: var(--lime); }
  .qz-dot { position: relative; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--lime); }
  .qz-dot::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--lime); animation: qz-pulse 2.4s ease-out infinite; }
  @keyframes qz-pulse { 0% { transform: scale(.5); opacity: .8; } 100% { transform: scale(1.4); opacity: 0; } }
  .qz-h1 { font-size: clamp(2.4rem, 5.4vw, 5.25rem); line-height: .94; letter-spacing: -.03em; font-weight: 600; max-width: 13ch; text-wrap: balance; }
  .qz-h1 .dim { display: block; color: var(--gray-400); }
  .qz-sub { font-size: var(--fs-body-l); line-height: 1.5; color: var(--gray-300); max-width: 46ch; }
  .qz-tip { display: flex; gap: .65rem; align-items: flex-start; color: var(--gray-200); font-size: .95rem; max-width: 46ch; padding: .7rem .9rem; border: 1px dashed var(--gray-500); border-radius: 12px; }
  .qz-eye { position: relative; flex: none; width: 18px; height: 12px; margin-top: .3em; border: 1.5px solid var(--lime); border-radius: 50% / 60%; }
  .qz-eye::after { content: ''; position: absolute; left: 50%; top: 50%; width: 5px; height: 5px; margin: -2.5px; border-radius: 50%; background: var(--lime); }
  .qz-go-row { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; margin-top: .25rem; }
  .qz-go { min-height: 64px; padding: 0 2rem; font-size: 1.125rem; }
  .qz-book-link { color: var(--gray-300); text-decoration: underline; text-decoration-color: var(--gray-500); text-underline-offset: 4px; min-height: 44px; display: inline-flex; align-items: center; }
  .qz-book-link:hover { color: var(--lime); text-decoration-color: var(--lime); }
  .qz-under { color: var(--gray-400); }
  .qz-textbtn { background: none; border: 0; padding: 0; color: var(--gray-300); font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 44px; }
  .qz-textbtn:hover { color: var(--lime); }
  .qz-nojs { color: var(--gray-200); max-width: 46ch; }
  :global(html:not(.js)) .qz-go-row .qz-go { display: none; }
  .qz-trust { display: flex; flex-wrap: wrap; gap: .4rem 1.75rem; color: var(--gray-400); list-style: none; padding: 0; margin: 0; }
  .qz-trust li { display: inline-flex; align-items: center; gap: .55rem; }
  .qz-trust li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--lime); }

  /* the reward card (decorative) */
  .qz-card { border: 1px solid var(--gray-700); background: var(--capsule); border-radius: 18px; padding: 22px 24px; display: grid; gap: 14px; box-shadow: var(--capsule-sh); }
  .qz-card-hd, .qz-card-ft { display: flex; justify-content: space-between; align-items: center; margin: 0; color: var(--gray-300); }
  .qz-card-ft { color: var(--lime); border-top: 1px solid var(--gray-700); padding-top: 14px; }
  .qz-card-score { display: flex; align-items: baseline; gap: .3rem; font-family: var(--font-display); font-weight: 600; line-height: .9; }
  .qz-card-q { font-size: clamp(4rem, 7vw, 6.5rem); letter-spacing: -.04em; color: var(--white); }
  .qz-of { font-size: 1.5rem; color: var(--gray-400); letter-spacing: -.01em; }
  .qz-card-areas { display: grid; gap: 10px; list-style: none; padding: 0; margin: 0; }
  .qz-card-areas li { display: grid; grid-template-columns: 8.5rem 1fr; align-items: center; gap: 12px; color: var(--gray-300); font-size: .95rem; }
  .qz-card-areas i { height: 6px; border-radius: 3px; background: repeating-linear-gradient(90deg, var(--gray-700) 0 calc(16.66% - 3px), transparent calc(16.66% - 3px) 16.66%); position: relative; overflow: hidden; }
  .qz-card-areas i::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, var(--lime) 0 calc(16.66% - 3px), transparent calc(16.66% - 3px) 16.66%); transform-origin: left; animation: qz-fill 6s calc(var(--i) * .35s + .4s) var(--ease-out) infinite both; }
  @keyframes qz-fill { 0% { clip-path: inset(0 100% 0 0); } 25%, 80% { clip-path: inset(0 calc(100% - (30% + var(--i) * 13%)) 0 0); } 100% { clip-path: inset(0 100% 0 0); } }
  .qz-card-lock { width: 12px; height: 10px; border-radius: 2px; background: var(--lime); position: relative; margin-top: 5px; }
  .qz-card-lock::before { content: ''; position: absolute; left: 2px; right: 2px; top: -6px; height: 8px; border: 1.5px solid var(--lime); border-bottom: 0; border-radius: 5px 5px 0 0; }

  @media (min-width: 1024px) {
    .qz-start { grid-template-columns: minmax(0, 7fr) minmax(0, 4.5fr); column-gap: clamp(2rem, 5vw, 6rem); }
    .qz-trust { grid-column: 1 / -1; padding-top: 1.25rem; border-top: 1px solid var(--gray-700); }
  }
  @media (max-width: 1023px) {
    .qz-card { display: none; }
  }

  /* ── Question chrome ───────────────────────────────────── */
  .qz-top { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 10px 16px; margin-bottom: clamp(1.25rem, 3vw, 2.5rem); }
  .qz-back { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: 0 1rem 0 .8rem; border-radius: 999px; border: 1px solid var(--gray-500); background: transparent; color: var(--white); font: inherit; font-weight: 500; cursor: pointer; }
  .qz-back:hover { border-color: var(--white); }
  .qz-back:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }
  .qz-count { justify-self: end; color: var(--gray-300); }
  .qz-count :global(b) { color: var(--white); font-weight: 400; }
