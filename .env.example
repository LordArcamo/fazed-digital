# HubSpot Form GUID
# Found in: HubSpot → Marketing → Forms → [your form] → edit URL
# URL format: app.hubspot.com/forms/244473168/{FORM_GUID}/edit
HUBSPOT_FORM_GUID=c119e15a-357c-4bfb-9264-a1fb3f1a3389

# Google reCAPTCHA v3 — get from console.cloud.google.com/recaptcha
# Site key is public (hardcoded in ContactSection.tsx)
# Secret key goes here (server-side verification only)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google Workspace (Gmail SMTP) — sender for contact + LP lead emails (src/lib/mail.ts)
# Create at myaccount.google.com/apppasswords while signed in as GMAIL_USER (needs 2-Step Verification).
# Spaces in the 16-character password are fine.
GMAIL_APP_PASSWORD=your_16_char_app_password_here
# The Workspace account that signs in and sends. Defaults to info@fazeddigital.com.
# GMAIL_USER=info@fazeddigital.com
