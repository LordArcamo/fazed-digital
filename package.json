{
  "name": "fazed-digital",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev --port 4351",
    "build": "node scripts/extract-posts.mjs && node scripts/bake-formations.mjs && node scripts/generate-og.mjs && node scripts/gen-llms.mjs && astro build && node scripts/lint-dist.mjs",
    "check": "astro check",
    "preview:lh": "node scripts/precompress.mjs && sirv .vercel/output/static --port 4352 --quiet --brotli --gzip",
    "generate:og": "node scripts/generate-og.mjs",
    "bake": "node scripts/bake-formations.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.15",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "astro": "7.4.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "nodemailer": "10.1.2",
    "three": "0.186.1"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/three": "0.186.0",
    "puppeteer-core": "25.14.0",
    "satori": "0.26.0",
    "sharp": "0.35.5",
    "sirv-cli": "3.0.1",
    "typescript": "6.0.3"
  }
